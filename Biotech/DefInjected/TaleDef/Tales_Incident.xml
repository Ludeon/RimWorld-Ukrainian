<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- EN: acidic smog -->
  <NoxiousHaze.label>кислотний смог</NoxiousHaze.label>
  <!-- EN:
    <li>tale_noun->acidic smog sweeping over [PAWN_nameDef]'s [Community]</li>
    <li>tale_noun->the atmosphere near [PAWN_nameDef]'s [Community] becoming noxious</li>
    <li>image->an ominous sky, [circumstance_group]</li>
    <li>image->the air becoming thick and [circumstance_group]</li>
    <li>circumstance_phrase->with no life in sight</li>
    <li>circumstance_phrase->waiting for the acidic smog to clear</li>
    <li>circumstance_phrase->watching the animals flee</li>
    <li>desc_sentence->[PAWN_nameDef] hides near a [TerrainFeature], gazing out with a [AdjectiveAngsty] look.</li>
    <li>desc_sentence->[PAWN_nameDef] looks on with a cloth wrapped around [PAWN_possessive] face.</li>
    <li>desc_sentence->[Quantity_adjphrase] dead [Animal]s lay on the ground.</li>
    <li>desc_sentence->[Quantity_adjphrase] dying [Animal]s lay on the ground.</li>
    <li>desc_sentence->[Quantity_adjphrase] suffocating [Animal]s lay on the ground.</li>
    <li>desc_sentence->[Quantity_adjphrase] [Animal]s flee.</li>
  -->
  <NoxiousHaze.rulePack.rulesStrings>
    <li>tale_noun->кислотний смог накрив [Community_acc], де {PAWN_gender ? жив : жила} [PAWN_nameDef]</li>
    <li>tale_noun->повітря біля [Community_gen], де {PAWN_gender ? жив : жила} [PAWN_nameDef], стало отруйним</li>
    <li>image->зловісне небо, [circumstance_group]</li>
    <li>image->повітря, що стає густим і задушливим, [circumstance_group]</li>
    <li>circumstance_phrase->без жодних ознак життя довкола</li>
    <li>circumstance_phrase->у чеканні, поки розвіється кислотний смог</li>
    <li>circumstance_phrase->поки тварини тікають геть</li>
    <li>desc_sentence->[PAWN_nameDef] ховається біля [TerrainFeature_gen] і дивиться вдалину з [AdjectiveAngsty_ins] виразом обличчя.</li>
    <li>desc_sentence->[PAWN_nameDef] стежить за всім, обмотавши обличчя ганчіркою.</li>
    <li>desc_sentence->На землі лежать [Quantity_adjphrase] мертвих [Animal_pl_gen].</li>
    <li>desc_sentence->[Quantity_adjphrase] [Animal_pl_gen] конають на землі.</li>
    <li>desc_sentence->[Quantity_adjphrase] [Animal_pl_gen] задихаються, лежачи на землі.</li>
    <li>desc_sentence->[Quantity_adjphrase] [Animal_pl_gen] тікають геть.</li>
  </NoxiousHaze.rulePack.rulesStrings>
</LanguageData>
