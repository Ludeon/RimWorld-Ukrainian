<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- EN: {0} was born healthy -->
  <BabyBorn.stages.was_born_healthy.label>дитина {0} народилася здоровою</BabyBorn.stages.was_born_healthy.label>
  <!-- EN: My baby brings me so much joy. I would move earth and sky for my little one. -->
  <BabyBorn.stages.was_born_healthy.description>Моя дитина дарує мені стільки радості. Заради свого маляти я переверну небо й землю.</BabyBorn.stages.was_born_healthy.description>
  <!-- EN: fed on by {0} -->
  <FedOn.stages.fed_on_by.label>{0} {1_gender ? смоктав : смоктала} мою кров</FedOn.stages.fed_on_by.label>
  <!-- EN: I was violated by a bloodfeeder like some kind of livestock. -->
  <FedOn.stages.fed_on_by.description>Кровопивця пив з мене кров, наче з якоїсь худоби. Яке приниження.</FedOn.stages.fed_on_by.description>
  <!-- EN: ingested hemogen pack -->
  <IngestedHemogenPack.stages.ingested_hemogen_pack.label>{PAWN_gender ? випив : випила} гемоген</IngestedHemogenPack.stages.ingested_hemogen_pack.label>
  <!-- EN: I ingested a hemogen pack. It might keep me alive, but it was absolutely disgusting. -->
  <IngestedHemogenPack.stages.ingested_hemogen_pack.description>Я {PAWN_gender ? випив : випила} гемопак. Може, це й тримає мене при житті, але гидота неймовірна.</IngestedHemogenPack.stages.ingested_hemogen_pack.description>
  <!-- EN: miscarried -->
  <Miscarried.stages.miscarried.label>викидень</Miscarried.stages.miscarried.label>
  <!-- EN: I lost my child. -->
  <Miscarried.stages.miscarried.description>Я втратила свою дитину.</Miscarried.stages.miscarried.description>
  <!-- EN: {0} miscarried -->
  <PartnerMiscarried.stages.miscarried.label>викидень у партнерки ({0})</PartnerMiscarried.stages.miscarried.label>
  <!-- EN: My child's story ended before it started. -->
  <PartnerMiscarried.stages.miscarried.description>Історія моєї дитини закінчилася ще до її початку.</PartnerMiscarried.stages.miscarried.description>
  <!-- EN: pregnancy ended -->
  <PregnancyEnded.stages.pregnancy_ended.label>вагітність закінчилася</PregnancyEnded.stages.pregnancy_ended.label>
  <!-- EN: I'm relieved I'm not pregnant any more. -->
  <PregnancyEnded.stages.pregnancy_ended.description>Яке полегшення, що я більше не вагітна.</PregnancyEnded.stages.pregnancy_ended.description>
