<LanguageData>
  <!-- EN: abhorrent -->
  <Slavery_Abhorrent.label>огидно</Slavery_Abhorrent.label>
  <!-- EN: Owning or trading human beings is deeply evil. -->
  <Slavery_Abhorrent.description>Володіти людьми чи торгувати ними — глибоке зло.</Slavery_Abhorrent.description>
  <!-- EN: Each slave in colony -->
  <Slavery_Abhorrent.comps.0.description>Кожен раб у колонії</Slavery_Abhorrent.comps.0.description>
  <!-- EN: Someone sold a slave -->
  <Slavery_Abhorrent.comps.5.description>Хтось продав раба</Slavery_Abhorrent.comps.5.description>
  <!-- EN: acceptable -->
  <Slavery_Acceptable.label>прийнятно</Slavery_Acceptable.label>
  <!-- EN: Slavery is a normal, unremarkable part of life. -->
  <Slavery_Acceptable.description>Рабство — звичайна, буденна частина життя.</Slavery_Acceptable.description>
  <!-- EN: disapproved -->
  <Slavery_Disapproved.label>осуджується</Slavery_Disapproved.label>
  <!-- EN: Slavery is part of life, though it is extremely distasteful. -->
  <Slavery_Disapproved.description>Рабство — частина життя, хоч і вкрай неприємна.</Slavery_Disapproved.description>
  <!-- EN: Each slave in colony -->
  <Slavery_Disapproved.comps.0.description>Кожен раб у колонії</Slavery_Disapproved.comps.0.description>
