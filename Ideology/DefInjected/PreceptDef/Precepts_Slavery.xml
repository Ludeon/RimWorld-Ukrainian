  <Slavery_Disapproved.comps.5.description>Хтось продав раба</Slavery_Disapproved.comps.5.description>
  <!-- EN: Someone enslaved a prisoner -->
  <Slavery_Disapproved.comps.6.description>Хтось поневолив в’язня</Slavery_Disapproved.comps.6.description>
  <!-- EN: honorable -->
  <Slavery_Honorable.label>почесно</Slavery_Honorable.label>
  <!-- EN: One who owns and trades slaves should be honored and respected. -->
  <Slavery_Honorable.description>Того, хто володіє рабами й торгує ними, слід шанувати й поважати.</Slavery_Honorable.description>
  <!-- EN: Each slave in colony -->
  <Slavery_Honorable.comps.0.description>Кожен раб у колонії</Slavery_Honorable.comps.0.description>
