<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- EN: medical only -->
  <DrugUse_MedicalOnly.label>тільки у медичних цілях</DrugUse_MedicalOnly.label>
  <!-- EN: Poisoning the body for recreational purposes is a deeply immoral act. -->
  <DrugUse_MedicalOnly.description>Отруювати тіло заради розваги – глибоко аморальний вчинок.</DrugUse_MedicalOnly.description>
  <!-- EN: Ingest recreational drug -->
  <DrugUse_MedicalOnly.comps.2.description>Вживання наркотику для дозвілля</DrugUse_MedicalOnly.comps.2.description>
  <!-- EN: Administer recreational drug -->
  <DrugUse_MedicalOnly.comps.5.description>Надання наркотику для дозвілля</DrugUse_MedicalOnly.comps.5.description>
  <!-- EN: medical or social only -->
  <DrugUse_MedicalOrSocial.label>тільки у медичних або соціальних цілях</DrugUse_MedicalOrSocial.label>
  <!-- EN: A drink with a smoke is fine, especially with friends, but poisoning the body with powerful chemicals is wrong. -->
  <DrugUse_MedicalOrSocial.description>Випити чарку й покурити – нормально, особливо з друзями, але отруювати тіло сильною хімією – неправильно.</DrugUse_MedicalOrSocial.description>
  <!-- EN: Ingest hard drug -->
  <DrugUse_MedicalOrSocial.comps.2.description>Вживання важкого наркотику</DrugUse_MedicalOrSocial.comps.2.description>
  <!-- EN: Administer hard drug -->
  <DrugUse_MedicalOrSocial.comps.5.description>Надання важкого наркотику</DrugUse_MedicalOrSocial.comps.5.description>
  <!-- EN: prohibited -->
  <DrugUse_Prohibited.label>заборонено</DrugUse_Prohibited.label>
  <!-- EN: The body should absolutely not be poisoned by chemicals. The only exception is the use of medicine in direct medical care. -->
  <DrugUse_Prohibited.description>Тіло в жодному разі не можна отруювати хімією. Єдиний виняток – ліки, застосовані безпосередньо для лікування.</DrugUse_Prohibited.description>
  <!-- EN: Ingest drug -->
  <DrugUse_Prohibited.comps.0.description>Вживання наркотику</DrugUse_Prohibited.comps.0.description>
  <!-- EN: Administer drug -->
  <DrugUse_Prohibited.comps.5.description>Надання наркотику</DrugUse_Prohibited.comps.5.description>
</LanguageData>
