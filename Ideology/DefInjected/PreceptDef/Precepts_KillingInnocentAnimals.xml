<LanguageData>
  <!-- EN: abhorrent -->
  <KillingInnocentAnimals_Abhorrent.label>огидно</KillingInnocentAnimals_Abhorrent.label>
  <!-- EN: To kill an innocent animal is a horrifically inhuman act. Innocent animals are those who are not attacking, or who were only driven to attack by human provocation. -->
  <KillingInnocentAnimals_Abhorrent.description>Убити невинну тварину — жахливо нелюдський вчинок. Невинні тварини — ті, що не нападають або напали лише через людську провокацію.</KillingInnocentAnimals_Abhorrent.description>
  <!-- EN: Kill innocent animal -->
  <KillingInnocentAnimals_Abhorrent.comps.2.description>Убивство невинної тварини</KillingInnocentAnimals_Abhorrent.comps.2.description>
  <!-- EN: disapproved -->
  <KillingInnocentAnimals_Disapproved.label>осуджується</KillingInnocentAnimals_Disapproved.label>
