<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- EN: always abhorrent -->
  <Execution_Abhorrent.label>завжди огидно</Execution_Abhorrent.label>
  <!-- EN: Executing a prisoner is an abhorrent evil under any circumstances. -->
  <Execution_Abhorrent.description>Страта в’язня — огидне зло за будь-яких обставин.</Execution_Abhorrent.description>
  <!-- EN: Executed prisoner -->
  <Execution_Abhorrent.comps.2.description>Страчено в’язня</Execution_Abhorrent.comps.2.description>
  <!-- EN: Responsible for prisoner death -->
  <Execution_Abhorrent.comps.3.description>Відповідальний за смерть в’язня</Execution_Abhorrent.comps.3.description>
  <!-- EN: Someone executed a colonist -->
  <Execution_Abhorrent.comps.4.description>Хтось стратив колоніста</Execution_Abhorrent.comps.4.description>
  <!-- EN: Someone executed a guest -->
  <Execution_Abhorrent.comps.5.description>Хтось стратив гостя</Execution_Abhorrent.comps.5.description>
  <!-- EN: Someone executed a prisoner -->
  <Execution_Abhorrent.comps.6.description>Хтось стратив в’язня</Execution_Abhorrent.comps.6.description>
  <!-- EN: don't care -->
  <Execution_DontCare.label>байдуже</Execution_DontCare.label>
  <!-- EN: Executing prisoners is acceptable, whether they are guilty or innocent. -->
  <Execution_DontCare.description>Страчувати в’язнів прийнятно, хоч винні вони, хоч ні.</Execution_DontCare.description>
  <!-- EN: always horrible -->
  <Execution_Horrible.label>завжди жахливо</Execution_Horrible.label>
  <!-- EN: Executing a prisoner is a horrible thing under any circumstances. -->
  <Execution_Horrible.description>Страта в’язня — жахлива річ за будь-яких обставин.</Execution_Horrible.description>
  <!-- EN: Executed prisoner -->
  <Execution_Horrible.comps.2.description>Страчено в’язня</Execution_Horrible.comps.2.description>
  <!-- EN: Responsible for prisoner death -->
  <Execution_Horrible.comps.3.description>Відповідальний за смерть в’язня</Execution_Horrible.comps.3.description>
  <!-- EN: Someone executed a colonist -->
  <Execution_Horrible.comps.5.description>Хтось стратив колоніста</Execution_Horrible.comps.5.description>
  <!-- EN: Someone executed a guest -->
  <Execution_Horrible.comps.6.description>Хтось стратив гостя</Execution_Horrible.comps.6.description>
  <!-- EN: Someone executed a prisoner -->
  <Execution_Horrible.comps.7.description>Хтось стратив в’язня</Execution_Horrible.comps.7.description>
  <!-- EN: horrible if innocent -->
  <Execution_HorribleIfInnocent.label>жахливо, якщо невинний</Execution_HorribleIfInnocent.label>
  <!-- EN: Executing an innocent prisoner is a horrible thing. If the prisoner is guilty, it's acceptable. -->
  <Execution_HorribleIfInnocent.description>Страта невинного в’язня — жахлива річ. Якщо ж в’язень винний, це прийнятно.</Execution_HorribleIfInnocent.description>
  <!-- EN: Executed innocent prisoner -->
  <Execution_HorribleIfInnocent.comps.2.description>Страчено невинного в’язня</Execution_HorribleIfInnocent.comps.2.description>
  <!-- EN: Responsible for innocent prisoner death -->
  <Execution_HorribleIfInnocent.comps.3.description>Відповідальний за смерть невинного в’язня</Execution_HorribleIfInnocent.comps.3.description>
  <!-- EN: Someone executed a colonist -->
  <Execution_HorribleIfInnocent.comps.5.description>Хтось стратив колоніста</Execution_HorribleIfInnocent.comps.5.description>
  <!-- EN: Someone executed a guest -->
  <Execution_HorribleIfInnocent.comps.6.description>Хтось стратив гостя</Execution_HorribleIfInnocent.comps.6.description>
  <!-- EN: Someone executed a prisoner -->
  <Execution_HorribleIfInnocent.comps.7.description>Хтось стратив в’язня</Execution_HorribleIfInnocent.comps.7.description>
  <!-- EN: required -->
  <Execution_Required.label>обов’язково</Execution_Required.label>
  <!-- EN: Prisoners must be executed on a regular basis. When they are, it is a happy occasion. -->
  <Execution_Required.description>В’язнів треба регулярно страчувати. Кожна страта — радісна подія.</Execution_Required.description>
  <!-- EN: Executed prisoner -->
  <Execution_Required.comps.2.description>Страчено в’язня</Execution_Required.comps.2.description>
  <!-- EN: Responsible for prisoner death -->
  <Execution_Required.comps.3.description>Відповідальний за смерть в’язня</Execution_Required.comps.3.description>
  <!-- EN: Someone executed a prisoner -->
  <Execution_Required.comps.4.description>Хтось стратив в’язня</Execution_Required.comps.4.description>
  <!-- EN: Someone executed a guest -->
  <Execution_Required.comps.5.description>Хтось стратив гостя</Execution_Required.comps.5.description>
  <!-- EN: No execution for {MINDAYSLASTEXECUTION} days -->
  <Execution_Required.comps.6.description>Без страт {MINDAYSLASTEXECUTION} дн.</Execution_Required.comps.6.description>
  <!-- EN: executed someone -->
  <Execution_Required.comps.7.eventLabel>когось страчено</Execution_Required.comps.7.eventLabel>
  <!-- EN: respected if guilty -->
  <Execution_RespectedIfGuilty.label>поважається, якщо винний</Execution_RespectedIfGuilty.label>
  <!-- EN: Executing prisoners is acceptable. If the prisoner is guilty, it is cause for great happiness. -->
  <Execution_RespectedIfGuilty.description>Страчувати в’язнів прийнятно. А якщо в’язень винний, це велика радість.</Execution_RespectedIfGuilty.description>
  <!-- EN: executed someone -->
  <Execution_RespectedIfGuilty.comps.3.eventLabel>когось страчено</Execution_RespectedIfGuilty.comps.3.eventLabel>
</LanguageData>
