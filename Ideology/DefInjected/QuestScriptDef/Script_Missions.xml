<LanguageData>
  <!-- EN:
    <li>terminalHackedMessage->Terminal hacked. {COUNT} / [terminalCount] complete.</li>
    <li>passengersIncapableOfHackingDialogLabel->[passengersSingularOrPlural] incapable of hacking.</li>
    <li>passengersIncapableOfHackingDialogText->The shuttle for the quest '[resolvedQuestName]' has no passenger capable of hacking. You must send at least one person capable of hacking to investigate the ancient complex.</li>
    <li>passengersSingularOrPlural(colonistCount==1)->passenger</li>
    <li>passengersSingularOrPlural(colonistCount>=2)->passengers</li>
  -->
  <AncientComplex_Mission.questContentRules.rulesStrings>
    <li>terminalHackedMessage->Термінал зламано. Виконано: {COUNT}/[terminalCount].</li>
    <li>passengersIncapableOfHackingDialogLabel->[passengersSingularOrPlural] зламувати</li>
    <li>passengersIncapableOfHackingDialogText->Серед пасажирів шатла для завдання «[resolvedQuestName]» немає нікого, хто вміє зламувати. Щоб дослідити старовинний комплекс, відправте принаймні одну людину, здатну на злам.</li>
    <li>passengersSingularOrPlural(colonistCount==1)->Пасажир не вміє</li>
    <li>passengersSingularOrPlural(colonistCount>=2)->Пасажири не вміють</li>
  </AncientComplex_Mission.questContentRules.rulesStrings>
