  -->
  <RelicHunt.questNameRules.rulesStrings>
    <li>questName->[hunt] [itemGen]</li>
    <li>questName->[itemAdj]</li>
    <li>questName->[item]</li>
    <li>questName(classicMode==False)->Святиня «[ideo_name]»</li>
    <li>hunt->Пошуки</li>
    <li>hunt->Розшуки</li>
    <li>hunt->У пошуках</li>
    <li>itemGen->реліквії</li>
    <li>itemGen->артефакту</li>
    <li>itemGen->святині</li>
    <li>item(p=4)->[relic_name]</li>
    <li>item->Реліквія</li>
    <li>item->Артефакт</li>
