  <!-- EN: I am on the verge of true enlightenment through blindness. -->
  <Blindness_Sublime_HalfBlind.stages.halfblind.description>Я на порозі справжнього просвітлення через сліпоту.</Blindness_Sublime_HalfBlind.stages.halfblind.description>
  <!-- EN: half-blind -->
  <Blindness_Sublime_HalfBlind_Social.stages.halfblind.label>напівсліпий</Blindness_Sublime_HalfBlind_Social.stages.halfblind.label>
