  <Blindness_Elevated_Blind.stages.blind.label>осліплення</Blindness_Elevated_Blind.stages.blind.label>
  <!-- EN: I can explore a greater awareness through my inability to see. -->
  <Blindness_Elevated_Blind.stages.blind.description>Сліпота відкриває мені шлях до глибшого усвідомлення.</Blindness_Elevated_Blind.stages.blind.description>
