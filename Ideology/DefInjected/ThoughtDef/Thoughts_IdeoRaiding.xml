<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- EN: participated in raid -->
  <ParticipatedInRaid_Required.stages.participated_in_raid.label>участь в рейді</ParticipatedInRaid_Required.stages.participated_in_raid.label>
  <!-- EN: I participated in a raid! Now they'll all know me! -->
  <ParticipatedInRaid_Required.stages.participated_in_raid.description>Я {PAWN_gender ? взяв : взяла} участь у рейді! Тепер усі мене знатимуть!</ParticipatedInRaid_Required.stages.participated_in_raid.description>
  <!-- EN: participated in raid -->
  <ParticipatedInRaid_Respected.stages.participated_in_raid.label>участь у рейді</ParticipatedInRaid_Respected.stages.participated_in_raid.label>
  <!-- EN: I participated in a raid! That's how we do it! -->
  <ParticipatedInRaid_Respected.stages.participated_in_raid.description>Я {PAWN_gender ? взяв : взяла} участь у рейді! Ось як ми це робимо!</ParticipatedInRaid_Respected.stages.participated_in_raid.description>
  <!-- EN: recent conquest -->
  <RecentConquest_Required.stages.recent_conquest.label>недавнє завоювання</RecentConquest_Required.stages.recent_conquest.label>
  <!-- EN: We recently raided another faction. Their suffering will be their teacher. -->
  <RecentConquest_Required.stages.recent_conquest.description>Ми нещодавно напали на іншу фракцію. Страждання стануть їм за вчителя.</RecentConquest_Required.stages.recent_conquest.description>
  <!-- EN: no recent conquest -->
  <RecentConquest_Required.stages.no_recent_conquest.label>давно немає завоювань</RecentConquest_Required.stages.no_recent_conquest.label>
  <!-- EN: We haven't raided anyone for so long. We're despicable - helpless worms like the rest. -->
  <RecentConquest_Required.stages.no_recent_conquest.description>Ми так давно ні на кого не нападали. Ми жалюгідні – безпорадні хробаки, як і всі інші.</RecentConquest_Required.stages.no_recent_conquest.description>
  <!-- EN: recent conquest -->
  <RecentConquest_Respected.stages.recent_conquest.label>нещодавні завоювання</RecentConquest_Respected.stages.recent_conquest.label>
  <!-- EN: We recently raided another faction. That'll show them who's boss. -->
  <RecentConquest_Respected.stages.recent_conquest.description>Ми нещодавно напали на іншу фракцію. Хай знають, хто тут головний.</RecentConquest_Respected.stages.recent_conquest.description>
  <!-- EN: no recent conquest -->
  <RecentConquest_Respected.stages.no_recent_conquest.label>довгий час не було завоювань</RecentConquest_Respected.stages.no_recent_conquest.label>
  <!-- EN: It's been far too long since we raided anyone. They might stop fearing and respecting us. -->
  <RecentConquest_Respected.stages.no_recent_conquest.description>Ми вже надто давно ні на кого не нападали. Нас можуть перестати боятися й поважати.</RecentConquest_Respected.stages.no_recent_conquest.description>
</LanguageData>
