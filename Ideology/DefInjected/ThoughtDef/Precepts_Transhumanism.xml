<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- EN: harmful aging -->
  <AgeReversalDemanded.stages.harmful_aging.label>шкідливе старіння</AgeReversalDemanded.stages.harmful_aging.label>
  <!-- EN: I'm getting old. I should get an age reversal in a biosculpter pod. -->
  <AgeReversalDemanded.stages.harmful_aging.description>Я старію. Треба пройти омолодження в біоскульпторі.</AgeReversalDemanded.stages.harmful_aging.description>
  <!-- EN: terrible aging -->
  <AgeReversalDemanded.stages.terrible_aging.label>жахливе старіння</AgeReversalDemanded.stages.terrible_aging.label>
  <!-- EN: My youth is draining away. I should get an age reversal in a biosculpter pod. -->
  <AgeReversalDemanded.stages.terrible_aging.description>Моя молодість спливає. Треба пройти омолодження в біоскульпторі.</AgeReversalDemanded.stages.terrible_aging.description>
  <!-- EN: horrific aging -->
  <AgeReversalDemanded.stages.horrific_aging.label>смертельне старіння</AgeReversalDemanded.stages.horrific_aging.label>
  <!-- EN: I am trapped in a decaying prison of flesh! I need to get an age reversal in a biosculpter pod. -->
  <AgeReversalDemanded.stages.horrific_aging.description>Я {PAWN_gender ? замкнений : замкнена} у гниючій в'язниці з плоті! Мені треба пройти омолодження в біоскульпторі.</AgeReversalDemanded.stages.horrific_aging.description>
  <!-- EN: received age reversal -->
  <AgeReversalReceived.stages.received_age_reversal.label>{PAWN_gender ? омолодився : омолодилась}</AgeReversalReceived.stages.received_age_reversal.label>
  <!-- EN: Aging and death have no hold on me. I am forever, as an enhanced human ought to be. -->
  <AgeReversalReceived.stages.received_age_reversal.description>Старіння і смерть не мають наді мною влади. Я {PAWN_gender ? вічний : вічна}, як і належить покращеній людині.</AgeReversalReceived.stages.received_age_reversal.description>
  <!-- EN: used biosculpter pod -->
  <BioSculpterDespised.stages.used_biosculpter_pod.label>{PAWN_gender ? використав : використала} біоскульптор</BioSculpterDespised.stages.used_biosculpter_pod.label>
  <!-- EN: My body was despoiled by the use of a biosculpter pod. -->
  <BioSculpterDespised.stages.used_biosculpter_pod.description>Біоскульптор осквернив моє тіло.</BioSculpterDespised.stages.used_biosculpter_pod.description>
  <!-- EN: want neural supercharge -->
  <NeedNeuralSupercharge.stages.want_neural_supercharge.label>нестача нейронного надзаряду</NeedNeuralSupercharge.stages.want_neural_supercharge.label>
  <!-- EN: Without a neural supercharge, I'm running below my true capacity. It's depressing. -->
  <NeedNeuralSupercharge.stages.want_neural_supercharge.description>Без нейронного надзаряду я працюю не на повну силу. Це гнітить.</NeedNeuralSupercharge.stages.want_neural_supercharge.description>
  <!-- EN: used sleep accelerator -->
  <SleptUsingSleepAccelerator.stages.used_sleep_accelerator.label>{PAWN_gender ? використав : використала} прискорювач сну</SleptUsingSleepAccelerator.stages.used_sleep_accelerator.label>
  <!-- EN: I slept with a sleep accelerator. It's helping me attain my true potential, as one should. -->
  <SleptUsingSleepAccelerator.stages.used_sleep_accelerator.description>Я {PAWN_gender ? спав : спала} з прискорювачем сну. Він допомагає мені розкрити справжній потенціал, як і належить.</SleptUsingSleepAccelerator.stages.used_sleep_accelerator.description>
</LanguageData>
