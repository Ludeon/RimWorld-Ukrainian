<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- EN: enslave attempt -->
  <EnslaveAttempt.label>спроба поневолення</EnslaveAttempt.label>
  <!-- EN:
    <li>r_logentry->[INITIATOR_nameDef] told [RECIPIENT_nameDef] that [RECIPIENT_pronoun] must work for the colony.</li>
    <li>r_logentry->[INITIATOR_nameDef] informed [RECIPIENT_nameDef] that [RECIPIENT_pronoun] must obey orders and work.</li>
    <li>r_logentry->[INITIATOR_nameDef] ordered [RECIPIENT_nameDef] to prepare for a life of forced labour.</li>
    <li>r_logentry->[INITIATOR_nameDef] explained to [RECIPIENT_nameDef] that [RECIPIENT_pronoun] must work or face punishment.</li>
  -->
  <EnslaveAttempt.logRulesInitiator.rulesStrings>
    <li>r_logentry->[INITIATOR_nameDef] {INITIATOR_gender ? сказав : сказала}, що відтепер [RECIPIENT_nameDef] мусить працювати на колонію.</li>
    <li>r_logentry->[INITIATOR_nameDef] {INITIATOR_gender ? повідомив : повідомила}, що [RECIPIENT_nameDef] має коритися наказам і працювати.</li>
    <li>r_logentry->[INITIATOR_nameDef] {INITIATOR_gender ? оголосив : оголосила}, що відтепер [RECIPIENT_nameDef] житиме в примусовій праці.</li>
    <li>r_logentry->[INITIATOR_nameDef] {INITIATOR_gender ? пояснив : пояснила}, що [RECIPIENT_nameDef] мусить працювати, інакше буде покарання.</li>
  </EnslaveAttempt.logRulesInitiator.rulesStrings>
  <!-- EN: try to reduce will -->
  <ReduceWill.label>спроба зменшити волю</ReduceWill.label>
