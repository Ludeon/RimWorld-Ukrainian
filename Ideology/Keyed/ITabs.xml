<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- Character -->
  <!-- EN: Overrides some precepts related to -->
  <OverridesSomePrecepts>Скасовує деякі принципи, пов'язані з</OverridesSomePrecepts>
  <!-- EN: Agrees with memes -->
  <AgreeableMemes>Узгоджується з мемами</AgreeableMemes>
  <!-- EN: Conflicts with memes -->
  <DisagreeableMemes>Конфліктує з мемами</DisagreeableMemes>
  <!-- ITab titles -->
  <!-- EN: Slave -->
  <TabSlave>Раб</TabSlave>
  <!-- EN: The faction goodwill you will gain if you release a slave. This is affected by the slaves's physical and mental health. -->
  <SlaveReleaseRelationGainsDesc>Прихильність фракції, яку ви отримаєте, якщо відпустите раба. Залежить від фізичного й психічного здоров'я раба.</SlaveReleaseRelationGainsDesc>
  <!-- EN: Relations gain on release -->
  <SlaveReleasePotentialRelationGains>Прихильність за звільнення</SlaveReleasePotentialRelationGains>
  <!-- EN: Slave rebellion interval -->
  <SlaveRebellionMTBDays>Інтервал між повстаннями</SlaveRebellionMTBDays>
  <!-- EN: The average number of days between slave rebellion attempts. Only time awake is counted. This is affected by suppression, mood, health, proximity to weapons, the number of slaves on the map, and the presence of colonists on the map. -->
  <SlaveRebellionMTBDaysDescription>Середня кількість днів між спробами раба підняти повстання. Враховується лише час неспання. Залежить від пригнічення, настрою, здоров'я, близькості зброї, кількості рабів на мапі та присутності колоністів на мапі.</SlaveRebellionMTBDaysDescription>
  <!-- Slave tab -->
  <!-- EN: Suppression -->
  <Suppression>Пригнічення</Suppression>
  <!-- EN: Suppression is the psychological effect of fear and control on a slave. If suppression is low, slaves are more likely to rebel. -->
  <SuppressionDesc>Пригнічення – психологічний вплив страху й контролю на раба. Що нижче пригнічення, то ймовірніше раби повстануть.</SuppressionDesc>
  <!-- EN: Suppression fall rate -->
  <SuppressionFallRate>Швидкість зниження пригнічення</SuppressionFallRate>
  <!-- EN: Suppression falls over time depending on its current level:\n\n- {1}+ suppression: {0} per day\n- {4}-{3} suppression: {2} per day\n- {6}- suppression: {5} per day\n\nApparel and terror can also affect the suppression fall rate. This slave's fall rate calculation is -->
  <SuppressionFallRateDesc>Пригнічення з часом знижується залежно від поточного рівня:\n\n- пригнічення {1}+: {0} на день\n- пригнічення {4}-{3}: {2} на день\n- пригнічення {6}-: {5} на день\n\nНа швидкість зниження пригнічення також впливають одяг і жах. Для цього раба швидкість зниження розраховано так</SuppressionFallRateDesc>
  <!-- EN: Cannot emancipate -->
  <CannotEmancipate>Неможливо звільнити</CannotEmancipate>
  <!-- EN: Cannot imprison -->
  <CannotImprison>Неможливо ув'язнити</CannotImprison>
  <!-- EN: Current suppression -->
  <CurrentSuppression>Поточне пригнічення</CurrentSuppression>
  <!-- EN: Terror -->
  <Terror>Жах</Terror>
  <!-- EN: Terror is a way to keep slaves suppressed. It rises when the slave spends time near terrifying things like terror sculptures. A slave can only be affected by three terror sources at a time.\n\nWhile terror is high, suppression falls slower as follows -->
  <TerrorDescription>Жах допомагає тримати рабів пригніченими. Він зростає, коли раб перебуває поруч із чимось жахливим, наприклад зі скульптурами жаху. Одночасно на раба можуть діяти лише три джерела жаху.\n\nПоки жах високий, пригнічення знижується повільніше</TerrorDescription>
  <!-- EN: Recent terrifying observations -->
  <TerrorCurrentThoughts>Нещодавні жахливі видовища</TerrorCurrentThoughts>
  <!-- EN: Base interval -->
  <SuppressionBaseInterval>Базовий інтервал</SuppressionBaseInterval>
  <!-- EN: Moving capacity -->
  <SuppressionMovingCapacityFactor>Рухливість</SuppressionMovingCapacityFactor>
  <!-- EN: Suppression -->
  <SuppressionFactor>Пригнічення</SuppressionFactor>
  <!-- EN: Mood -->
  <SuppressionMoodFactor>Настрій</SuppressionMoodFactor>
  <!-- EN: Slave count -->
  <SuppressionSlaveCountFactor>Кількість рабів</SuppressionSlaveCountFactor>
  <!-- EN: Escape route -->
  <SuppressionEscapeFactor>Шлях утечі</SuppressionEscapeFactor>
  <!-- EN: Weapon proximity -->
  <SuppressionWeaponProximityFactor>Близькість зброї</SuppressionWeaponProximityFactor>
  <!-- EN: Final interval -->
  <SuppressionFinalInterval>Підсумковий інтервал</SuppressionFinalInterval>
  <!-- EN: Unattended -->
  <SuppressionUnattendedByColonists>Без нагляду</SuppressionUnattendedByColonists>
  <!-- EN: At least one of the {0} slaves on this map is expected rebel on average every {1}. -->
  <SuppressionRebellionAnySlave>Принаймні один із {0} рабів на цій мапі, імовірно, піднімає повстання в середньому раз на {1}.</SuppressionRebellionAnySlave>
  <!-- EN: Will -->
  <WillLevel>Воля</WillLevel>
  <!-- EN: How much the prisoner is determined not to submit. When this reaches zero, they can be enslaved. -->
  <WillLevelDesc>Наскільки в'язень налаштований не коритися. Коли воля впаде до нуля, його можна поневолити.</WillLevelDesc>
  <!-- EN: {0} base will -->
  <WillFromPawnKind>Базова воля: {0}</WillFromPawnKind>
  <!-- EN: Target ideoligion -->
  <IdeoConversionTarget>Цільова ідеологія</IdeoConversionTarget>
  <!-- EN: The ideoligion your wardens will attempt to convert this prisoner to. -->
  <IdeoConversionTargetDesc>Ідеологія, у яку ваші наглядачі намагатимуться навернути цього в'язня.</IdeoConversionTargetDesc>
  <!-- Social -->
  <!-- EN: Change per day due to mood -->
  <CertaintyChangePerDay>Зміна за день через настрій</CertaintyChangePerDay>
  <!-- EN: Change rate based on mood -->
  <MoodChangeRate>Швидкість зміни залежно від настрою</MoodChangeRate>
  <!-- EN: {PAWN_nameDef}'s certainty in {IDEO_name} -->
  <CertaintyInIdeo>{PAWN_nameDef}: впевненість в ідеології {IDEO_name}</CertaintyInIdeo>
  <!-- EN: A special status this person holds in their ideoligion. If you change or take away this role, they will become unhappy. -->
  <RoleDesc>Особливий статус цієї людини в її ідеології. Якщо змінити чи забрати роль, людина засмутиться.</RoleDesc>
  <!-- EN: Changing roles requires a role change ritual. Select any ritual spot or altar and press 'Begin role change'. -->
  <RoleAssignmentTip>Щоб змінити роль, потрібен ритуал зміни ролі. Виберіть будь-яке ритуальне місце чи вівтар і натисніть «Розпочати зміну ролі».</RoleAssignmentTip>
  <!-- EN: Conversion attempts will be weaker because of trait/meme agreement -->
  <ConversionWeakerDueToTraitAgreements>Спроби навернення будуть слабшими, бо риси узгоджуються з мемами</ConversionWeakerDueToTraitAgreements>
  <!-- EN: Conversion attempts will be stronger because of trait/meme conflict -->
  <ConversionStrongerDueToTraitAgreements>Спроби навернення будуть сильнішими, бо риси суперечать мемам</ConversionStrongerDueToTraitAgreements>
  <!-- EN: Cut -->
  <Cut>Виколоти</Cut>
  <!-- EN: Cut both eyes -->
  <CutBothEyes>Виколоти обидва ока</CutBothEyes>
</LanguageData>
