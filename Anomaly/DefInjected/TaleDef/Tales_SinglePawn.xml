<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- EN: closed the void node -->
  <ClosedTheVoid.label>закриття вузла порожнечі</ClosedTheVoid.label>
  <!-- EN:
    <li>tale_noun->[PAWN_nameDef] closing the void node.</li>
    <li>image->[PAWN_nameFull] sealing the connection to the void, ensuring the safety of the colony [circumstance_group]</li>
    <li>image->[PAWN_nameFull] standing defiantly before the void node, determined to protect the colony [circumstance_group]</li>
    <li>circumstance_phrase->amidst crackling energy</li>
    <li>circumstance_phrase->as the void node emits a haunting glow</li>
    <li>circumstance_phrase->while the void whispers in the background</li>
    <li>desc_sentence->The gray metal presses in from all sides.</li>
    <li>desc_sentence->The other colonists are shown [side_position], anxiously awaiting [PAWN_nameDef]'s return.</li>
    <li>desc_sentence->[PAWN_nameDef]'s face betrays that [PAWN_pronoun] is agonising over the choice before [PAWN_objective].</li>
  -->
  <ClosedTheVoid.rulePack.rulesStrings>
    <li>tale_noun->[PAWN_nameDef] закриває вузол порожнечі</li>
    <li>image->[PAWN_nameFull] запечатує зв'язок із порожнечею, щоб уберегти колонію, [circumstance_group]</li>
    <li>image->[PAWN_nameFull] зухвало стоїть перед вузлом порожнечі, {PAWN_gender ? сповнений : сповнена} рішучості захистити колонію, [circumstance_group]</li>
    <li>circumstance_phrase->серед тріскучої енергії</li>
    <li>circumstance_phrase->а вузол порожнечі випромінює моторошне сяйво</li>
    <li>circumstance_phrase->а на тлі шепоче порожнеча</li>
    <li>desc_sentence->Сірий метал тисне з усіх боків.</li>
    <li>desc_sentence->Інших колоністів зображено [side_position]: вони тривожно чекають, коли повернеться [PAWN_nameDef].</li>
    <li>desc_sentence->Обличчя видає, як болісно [PAWN_nameDef] вагається перед вибором.</li>
  </ClosedTheVoid.rulePack.rulesStrings>
  <!-- EN: embraced the void -->
  <EmbracedTheVoid.label>обійми порожнечі</EmbracedTheVoid.label>
  <!-- EN:
    <li>tale_noun->[PAWN_nameDef] embracing the void</li>
    <li>image->[PAWN_nameFull] harnessing the forbidden knowledge of the void, transcending mortal limitations, [circumstance_group]</li>
    <li>image->[PAWN_nameFull] surrendering to the allure of the void [circumstance_group]</li>
    <li>image->[PAWN_nameFull] giving in to the sinister whispers of the void [circumstance_group]</li>
    <li>circumstance_phrase->as tendrils of dark energy coil around [PAWN_possessive] limbs</li>
    <li>circumstance_phrase->amidst a swirling vortex of energy</li>
    <li>circumstance_phrase->with an unsettling smile</li>
    <li>desc_sentence->[PAWN_nameDef] radiates an aura of ominous power, a testament to [PAWN_possessive] pact with the void.</li>
    <li>desc_sentence->[PAWN_nameDef]'s eyes begin to gleam with an otherworldly glow.</li>
    <li>desc_sentence->The other colonists are shown [side_position], questioning the wisdom of [PAWN_nameDef]'s choice.</li>
  -->
  <EmbracedTheVoid.rulePack.rulesStrings>
    <li>tale_noun->[PAWN_nameDef] віддається порожнечі</li>
    <li>image->[PAWN_nameFull] опановує заборонене знання порожнечі, долаючи межі смертних, [circumstance_group]</li>
    <li>image->[PAWN_nameFull] піддається чарам порожнечі, [circumstance_group]</li>
    <li>image->[PAWN_nameFull] коряється зловісному шепоту порожнечі, [circumstance_group]</li>
    <li>circumstance_phrase->а щупальця темної енергії обвивають {PAWN_gender ? його : її} руки й ноги</li>
    <li>circumstance_phrase->посеред вируючого вихору енергії</li>
    <li>circumstance_phrase->з тривожною усмішкою</li>
    <li>desc_sentence->[PAWN_nameDef] випромінює ауру зловісної сили – свідчення угоди з порожнечею.</li>
    <li>desc_sentence->Очі, якими дивиться [PAWN_nameDef], сяють потойбічним світлом.</li>
    <li>desc_sentence->Інших колоністів зображено [side_position]: вони сумніваються в мудрості вибору, який {PAWN_gender ? зробив : зробила} [PAWN_nameDef].</li>
  </EmbracedTheVoid.rulePack.rulesStrings>
  <!-- EN: performed a psychic ritual -->
  <PerformedPsychicRitual.label>проведення психічного ритуалу</PerformedPsychicRitual.label>
  <!-- EN:
    <li>tale_noun->[PAWN_nameDef] leading a psychic ritual</li>
    <li>image->[PAWN_nameFull] channeling energy that dances around [PAWN_objective] as [PAWN_pronoun] weaves a potent psychic ritual, [circumstance_group]</li>
    <li>image->[PAWN_nameFull] reciting dark incantations and tapping into mysterious forces to perform a psychic ritual, [circumstance_group]</li>
    <li>image->[PAWN_nameFull] focusing [PAWN_possessive] gaze as [PAWN_pronoun] performs a psychic ritual, [circumstance_group]</li>
    <li>image->[PAWN_nameFull] tracing intricate symbols in the air, harnessing hidden energies to manifest a psychic ritual, [circumstance_group]</li>
    <li>circumstance_phrase->while focusing intently on the tome in front of [PAWN_objective]</li>
    <li>circumstance_phrase->with focused determination, showcasing [PAWN_possessive] mastery of the psychic arts</li>
    <li>circumstance_phrase->with a cruel smile</li>
    <li>circumstance_phrase->while [PAWN_possessive] voice fights to be heard over the roar of energy</li>
    <li>desc_sentence->The chanters can be seen [side_position] lending their support.</li>
    <li>desc_sentence->The air shimmers as [PAWN_nameDef] completes the psychic ritual.</li>
    <li>desc_sentence->The monolith shimmers in the background.</li>
    <li>desc_sentence->The surrounding candles flicker and sputter in the swirling energy.</li>
  -->
  <PerformedPsychicRitual.rulePack.rulesStrings>
    <li>tale_noun->[PAWN_nameDef] проводить психічний ритуал</li>
    <li>image->[PAWN_nameFull] спрямовує енергію, що танцює довкола, і творить потужний психічний ритуал, [circumstance_group]</li>
    <li>image->[PAWN_nameFull] читає темні заклинання й черпає таємничі сили, щоб провести психічний ритуал, [circumstance_group]</li>
    <li>image->[PAWN_nameFull] зосереджує погляд, проводячи психічний ритуал, [circumstance_group]</li>
    <li>image->[PAWN_nameFull] виводить у повітрі складні символи й скеровує приховані енергії, щоб провести психічний ритуал, [circumstance_group]</li>
    <li>circumstance_phrase->не відводячи очей від фоліанта</li>
    <li>circumstance_phrase->із зосередженою рішучістю, що виказує майстерність у психічних мистецтвах</li>
    <li>circumstance_phrase->з жорстокою усмішкою</li>
    <li>circumstance_phrase->перекрикуючи рев енергії</li>
    <li>desc_sentence->Співців, що підтримують ритуал, зображено [side_position].</li>
    <li>desc_sentence->Коли [PAWN_nameDef] завершує психічний ритуал, повітря мерехтить.</li>
    <li>desc_sentence->На тлі мерехтить моноліт.</li>
    <li>desc_sentence->Свічки довкола мерехтять і тріщать у вирі енергії.</li>
  </PerformedPsychicRitual.rulePack.rulesStrings>
</LanguageData>
