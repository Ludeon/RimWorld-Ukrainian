<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- EN: dark visions -->
  <DarkVisions.label>темні видіння</DarkVisions.label>
  <!-- EN: Mental state: Dark visions -->
  <DarkVisions.baseInspectLine>Психічний стан: темні видіння</DarkVisions.baseInspectLine>
  <!-- EN: {PAWN_nameDef} has become overwhelmed with horrible visions, rambling about things that only {PAWN_pronoun} can see. {PAWN_pronoun} will snap out of it in a few hours. -->
  <DarkVisions.beginLetter>{PAWN_nameDef} охоплюють жахливі видіння, і {PAWN_pronoun} белькоче про речі, які бачить лише {PAWN_gender ? він : вона}. За кілька годин це мине.</DarkVisions.beginLetter>
  <!-- EN: dark visions -->
  <DarkVisions.beginLetterLabel>темні видіння</DarkVisions.beginLetterLabel>
  <!-- EN: {PAWN_nameDef}'s dark visions have stopped. -->
  <DarkVisions.recoveryMessage>{PAWN_nameDef}: темні видіння скінчилися.</DarkVisions.recoveryMessage>
  <!-- EN: entity slayer -->
  <EntityKiller.label>вбивця сутностей</EntityKiller.label>
  <!-- EN: Mental state: Entity slayer -->
  <EntityKiller.baseInspectLine>Психічний стан: вбивця сутностей</EntityKiller.baseInspectLine>
  <!-- EN: {0} has snapped. {PAWN_pronoun} can no longer tolerate holding such dangerous entities in captivity and intends to destroy as many as {PAWN_pronoun} can. -->
  <EntityKiller.beginLetter>{0} зривається. {PAWN_pronoun} більше не може терпіти, що в полоні тримають таких небезпечних сутностей, і хоче знищити якомога більше з них.</EntityKiller.beginLetter>
  <!-- EN: {0} is no longer slaughtering random entities. -->
  <EntityKiller.recoveryMessage>{0} більше не вбиває сутностей.</EntityKiller.recoveryMessage>
  <!-- EN: entity liberator -->
  <EntityLiberator.label>визволитель сутностей</EntityLiberator.label>
  <!-- EN: Mental state: Entity liberator -->
  <EntityLiberator.baseInspectLine>Психічний стан: визволитель сутностей</EntityLiberator.baseInspectLine>
  <!-- EN: {0} has become suddenly allured by a captive entity and is convinced it must be freed. -->
  <EntityLiberator.beginLetter>{0} раптом {PAWN_gender ? зачарований : зачарована} полоненою сутністю й {PAWN_gender ? переконаний : переконана}, що її треба звільнити.</EntityLiberator.beginLetter>
  <!-- EN: {0} is no longer freeing entities. -->
  <EntityLiberator.recoveryMessage>{0} більше не звільняє сутностей.</EntityLiberator.recoveryMessage>
  <!-- EN: insane ramblings -->
  <InsaneRamblings.label>божевільні балачки</InsaneRamblings.label>
  <!-- EN: Mental state: Insane ramblings -->
  <InsaneRamblings.baseInspectLine>Психічний стан: божевільні балачки</InsaneRamblings.baseInspectLine>
  <!-- EN: {PAWN_nameDef} has become completely untethered from reality, ranting about impossible subjects. {PAWN_pronoun} will snap out of it in a few hours. -->
  <InsaneRamblings.beginLetter>{PAWN_nameDef} цілком відривається від реальності й несе нісенітниці про неможливі речі. За кілька годин це мине.</InsaneRamblings.beginLetter>
  <!-- EN: insane ramblings -->
  <InsaneRamblings.beginLetterLabel>божевільні балачки</InsaneRamblings.beginLetterLabel>
  <!-- EN: {PAWN_nameDef} has stopped rambling. -->
  <InsaneRamblings.recoveryMessage>{PAWN_nameDef} більше не белькоче.</InsaneRamblings.recoveryMessage>
  <!-- EN: terrifying hallucinations -->
  <TerrifyingHallucinations.label>жахливі галюцинації</TerrifyingHallucinations.label>
  <!-- EN: Mental state: Terrifying hallucinations -->
  <TerrifyingHallucinations.baseInspectLine>Психічний стан: жахливі галюцинації</TerrifyingHallucinations.baseInspectLine>
  <!-- EN: Vivid  hallucinations swirl around {0}, twisting and distorting allies into horrifying abominations. {PAWN_pronoun} will flee from anyone {PAWN_pronoun} perceives as a threat. -->
  <TerrifyingHallucinations.beginLetter>{0} бачить яскраві галюцинації: союзники спотворюються й перетворюються на жахливих потвор. {PAWN_pronoun} тікатиме від усіх, у кому бачить загрозу.</TerrifyingHallucinations.beginLetter>
  <!-- EN: terrifying hallucinations -->
  <TerrifyingHallucinations.beginLetterLabel>жахливі галюцинації</TerrifyingHallucinations.beginLetterLabel>
  <!-- EN: {0} is no longer hallucinating. -->
  <TerrifyingHallucinations.recoveryMessage>{0} більше не бачить галюцинацій.</TerrifyingHallucinations.recoveryMessage>
</LanguageData>
