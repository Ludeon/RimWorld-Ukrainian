  <!-- EN: Permanently and safely disable the twisted obelisk. This will prevent it from activating and being studied further.\n\nRequires 2 shards. -->
  <WarpedObelisk_Mutator.comps.CompObeliskDeactivationInteractor.activateDescString>Назавжди й безпечно вимкнути покручений обеліск. Він більше не активується, і його не можна буде вивчати далі.\n\nПотрібно 2 уламки.</WarpedObelisk_Mutator.comps.CompObeliskDeactivationInteractor.activateDescString>
  <!-- EN: Deactivate... -->
  <WarpedObelisk_Mutator.comps.CompObeliskDeactivationInteractor.activateLabelString>Деактивувати...</WarpedObelisk_Mutator.comps.CompObeliskDeactivationInteractor.activateLabelString>
