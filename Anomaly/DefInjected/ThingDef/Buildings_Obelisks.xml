  <!-- EN: deactivating obelisk -->
  <WarpedObelisk_Mutator.comps.CompObeliskDeactivationInteractor.activatingStringPending>деактивація обеліска</WarpedObelisk_Mutator.comps.CompObeliskDeactivationInteractor.activatingStringPending>
  <!-- EN: Choose who should do this -->
  <WarpedObelisk_Mutator.comps.CompObeliskDeactivationInteractor.guiLabelString>Оберіть, хто має це зробити</WarpedObelisk_Mutator.comps.CompObeliskDeactivationInteractor.guiLabelString>
