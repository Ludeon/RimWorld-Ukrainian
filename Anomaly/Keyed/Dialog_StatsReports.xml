  <StatsReport_BioferriteExtractedMultiplier>Множник нещодавно видобутого біофериту</StatsReport_BioferriteExtractedMultiplier>
  <!-- EN: Offering -->
  <StatsReport_Offering>Підношення</StatsReport_Offering>
  <!-- EN: The ingredients required to perform the psychic ritual. -->
  <StatsReport_Offering_Desc>Інгредієнти, потрібні для проведення психічного ритуалу.</StatsReport_Offering_Desc>
