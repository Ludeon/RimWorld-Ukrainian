  <!-- EN: Should depart on shuttle -->
  <Hospitality_Util_Worker.InspectStringDepartShuttle.slateRef>Має відправитися на шатлі</Hospitality_Util_Worker.InspectStringDepartShuttle.slateRef>
  <!-- EN: Shuttle arrived -->
  <Hospitality_Util_Worker.LetterLabelShuttleArrived.slateRef>Шатл прибув</Hospitality_Util_Worker.LetterLabelShuttleArrived.slateRef>
