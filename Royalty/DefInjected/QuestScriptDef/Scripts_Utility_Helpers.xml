<LanguageData>
  <!-- EN:
    <li>helpersParagraph(helpersCount==0)-></li>
    <li>helpersParagraph(helpersCount==1)->\n\nA [helperKind_label] will be placed under your control. You will have to feed and house [helpers0_objective], but [helpers0_pronoun] may die in battle without consequence.\n\n</li>
    <li>helpersParagraph(helpersCount>=2)->\n\n[helpersCount] [helperKind_labelPlural] will be placed under your control. You will have to feed and house them, but they may die in battle without consequence.\n\n</li>
    <li>helpersArrivalLetterEnd(helpersCount==0)-></li>
    <li>helpersArrivalLetterEnd(helpersCount>=1)->\n\n[helpersCount] [helpersLabelSingOrPlural] [helpersHasHave] been sent to assist you.</li>
    <li>helpersLabelSingOrPlural(helpersCount==1)->[helperKind_label]</li>
    <li>helpersLabelSingOrPlural(helpersCount>=2)->[helperKind_labelPlural]</li>
    <li>helpersHasHave(helpersCount==1)->has</li>
    <li>helpersHasHave(helpersCount>=2)->have</li>
    <li>helpersIsAre(helpersCount==1)->is</li>
    <li>helpersIsAre(helpersCount>=2)->are</li>
  -->
  <Util_MaybeGenerateHelpers.questDescriptionRules.rulesStrings>
    <li>helpersParagraph(helpersCount==0)-></li>
    <li>helpersParagraph(helpersCount==1)->\n\nПід ваше керівництво перейде [helperKind_label]. Вам доведеться годувати {helpers0_gender ? його : її} й дати житло, але якщо [helpers0_pronoun] загине в бою, наслідків не буде.\n\n</li>
    <li>helpersParagraph(helpersCount>=2)->\n\nПід ваше керівництво перейдуть [helperKind_labelPlural] ([helpersCount]). Вам доведеться годувати їх і дати їм житло, але якщо вони загинуть у бою, наслідків не буде.\n\n</li>
    <li>helpersArrivalLetterEnd(helpersCount==0)-></li>
    <li>helpersArrivalLetterEnd(helpersCount>=1)->\n\nВам на допомогу [helpersHasHave]: [helpersLabelSingOrPlural] ([helpersCount]).</li>
    <li>helpersLabelSingOrPlural(helpersCount==1)->[helperKind_label]</li>
    <li>helpersLabelSingOrPlural(helpersCount>=2)->[helperKind_labelPlural]</li>
    <li>helpersHasHave(helpersCount==1)->надіслано</li>
    <li>helpersHasHave(helpersCount>=2)->надіслано</li>
    <li>helpersIsAre(helpersCount==1)->іде</li>
    <li>helpersIsAre(helpersCount>=2)->ідуть</li>
  </Util_MaybeGenerateHelpers.questDescriptionRules.rulesStrings>
  <!-- EN: [helpersLabelSingOrPlural] arrived -->
  <Util_MaybeGenerateHelpers.LetterLabelHelpersArrived.value.slateRef>Прибуття: [helpersLabelSingOrPlural]</Util_MaybeGenerateHelpers.LetterLabelHelpersArrived.value.slateRef>
  <!-- EN: The [helpersLabelSingOrPlural] sent by [asker_nameDef] [helpersHasHave] arrived to aid you with the quest '[resolvedQuestName]'. -->
  <Util_MaybeGenerateHelpers.LetterTextHelpersArrived.value.slateRef>Прибули помічники, яких [asker_nameDef] {asker_gender ? надіслав : надіслала} вам на допомогу із завданням «[resolvedQuestName]»: [helpersLabelSingOrPlural].</Util_MaybeGenerateHelpers.LetterTextHelpersArrived.value.slateRef>
  <!-- EN: the [helpersLabelSingOrPlural] -->
  <Util_MaybeGenerateHelpers.ArrivingPawnsLabelDefinite.value.slateRef>[helpersLabelSingOrPlural]</Util_MaybeGenerateHelpers.ArrivingPawnsLabelDefinite.value.slateRef>
  <!-- EN: [helpersLabelSingOrPlural] leaving -->
  <Util_MaybeGenerateHelpers.LetterLabelHelpersLeaving.slateRef>Помічники йдуть: [helpersLabelSingOrPlural]</Util_MaybeGenerateHelpers.LetterLabelHelpersLeaving.slateRef>
  <!-- EN: The [helpersLabelSingOrPlural] sent by [asker_nameDef] to aid you [helpersHasHave] spent too much time with you, and [helpersIsAre] now leaving. -->
  <Util_MaybeGenerateHelpers.LetterTextHelpersLeaving.slateRef>Помічники, яких [asker_nameDef] {asker_gender ? надіслав : надіслала} вам на допомогу, пробули у вас надто довго й тепер ідуть: [helpersLabelSingOrPlural].</Util_MaybeGenerateHelpers.LetterTextHelpersLeaving.slateRef>
</LanguageData>
