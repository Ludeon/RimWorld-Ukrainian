<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- EN: harp -->
  <Harp.label>арфа</Harp.label>
  <!-- EN: Craft the harp, a simple stationary musical instrument popular among nobility in some cultures. -->
  <Harp.description>Виготовлення арфи — простого стаціонарного музичного інструмента, популярного серед знаті в деяких культурах.</Harp.description>
  <!-- EN:
    <li>subject->harps</li>
    <li>subject->simple string instruments</li>
    <li>subject_story->trained in the school of music</li>
    <li>subject_story->constructed a harp from common feral world materials</li>
    <li>subject_story->performed a harp solo for the Imperial nobility</li>
    <li>subject_story->practiced glissandos every day</li>
    <li>subject_story->researched the cultural significance of stringed instrument usage</li>
    <li>subject_gerund->playing the harp</li>
  -->
  <Harp.generalRules.rulesStrings>
    <li>subject->арфи</li>
    <li>subject->прості струнні інструменти</li>
    <li>subject_story->навчався в музичній школі</li>
    <li>subject_story->змайстрував арфу з простих матеріалів дикого світу</li>
    <li>subject_story->зіграв соло на арфі для імперської знаті</li>
    <li>subject_story->щодня відпрацьовував глісандо</li>
    <li>subject_story->досліджував культурне значення струнних інструментів</li>
    <li>subject_gerund->гра на арфі</li>
  </Harp.generalRules.rulesStrings>
  <!-- EN: harpsichord -->
  <Harpsichord.label>клавесин</Harpsichord.label>
  <!-- EN: Craft the harpsichord, a complex stationary musical instrument. -->
  <Harpsichord.description>Виготовлення клавесина — складного стаціонарного музичного інструмента.</Harpsichord.description>
  <!-- EN:
    <li>subject->harpsichord</li>
    <li>subject_story->led a renaissance in the harpsichord in the coreworld systems</li>
    <li>subject_story->tuned harpsichords for concert use on Glitterworlds</li>
    <li>subject_story->took up a role as lead harpischordist for the local philharmonic</li>
    <li>subject_story->constructed dual-keyboard harpsichords focused on harmonics</li>
    <li>subject_gerund->playing the harpsichord</li>
  -->
  <Harpsichord.generalRules.rulesStrings>
    <li>subject->клавесин</li>
    <li>subject_story->очолив відродження клавесина в центральних світах</li>
    <li>subject_story->налаштовував концертні клавесини у світах-раях</li>
    <li>subject_story->став провідним клавесиністом місцевої філармонії</li>
    <li>subject_story->конструював двомануальні клавесини з наголосом на гармоніках</li>
    <li>subject_gerund->гра на клавесині</li>
  </Harpsichord.generalRules.rulesStrings>
  <!-- EN: piano -->
  <Piano.label>фортепіано</Piano.label>
  <!-- EN: Craft the piano, an advanced stationary musical instrument. -->
  <Piano.description>Виготовлення фортепіано — досконалого стаціонарного музичного інструмента.</Piano.description>
  <!-- EN:
    <li>subject->piano</li>
    <li>subject_story->was acquainted with the entire corpus of stringed instruments</li>
    <li>subject_story->joined a music academy, where the students learned about composers as much as the piano itself</li>
    <li>subject_story->transported pianos between the coreworlds</li>
    <li>subject_story->recorded the techniques of several master pianists</li>
    <li>subject_story->constructed a strange piano</li>
    <li>subject_gerund->playing the piano</li>
  -->
  <Piano.generalRules.rulesStrings>
    <li>subject->фортепіано</li>
    <li>subject_story->знав увесь доробок струнних інструментів</li>
    <li>subject_story->вступив до музичної академії, де студенти вивчали композиторів не менше, ніж саме фортепіано</li>
    <li>subject_story->перевозив фортепіано між центральними світами</li>
    <li>subject_story->записував техніку кількох видатних піаністів</li>
    <li>subject_story->змайстрував дивне фортепіано</li>
    <li>subject_gerund->гра на фортепіано</li>
  </Piano.generalRules.rulesStrings>
</LanguageData>
