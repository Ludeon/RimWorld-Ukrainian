<LanguageData>
  <!-- EN: attended concert -->
  <AttendedConcert.label>відвідини концерту</AttendedConcert.label>
  <!-- EN:
    <li>tale_noun->[ATTENDER_nameDef] attending [ORGANIZER_nameDef]'s concert</li>
    <li>tale_noun->[ATTENDER_nameDef] listening to [ORGANIZER_nameDef]'s performance</li>
    <li>image->[ATTENDER_nameFull] listening quietly, [circumstance_group]</li>
    <li>image->[ATTENDER_nameFull] enjoying [ORGANIZER_nameFull]'s performance [circumstance_group]</li>
    <li>image->[ATTENDER_nameFull] swaying to the music [circumstance_group]</li>
    <li>image->[ATTENDER_nameFull] absorbed in the sound [circumstance_group]</li>
    <li>circumstance_phrase->while clapping</li>
    <li>desc_sentence->[Quantity_adjphrase] [PersonJob]s dance along.</li>
    <li>desc_sentence->[Quantity_adjphrase] [Animal]s listen attentively.</li>
  -->
  <AttendedConcert.rulePack.rulesStrings>
    <li>tale_noun->[ATTENDER_nameDef] слухає концерт, який дає [ORGANIZER_nameDef]</li>
    <li>tale_noun->[ATTENDER_nameDef] слухає виступ, який дає [ORGANIZER_nameDef]</li>
    <li>image->[ATTENDER_nameFull] тихо слухає музику [circumstance_group]</li>
    <li>image->[ATTENDER_nameFull] насолоджується виступом, а грає [ORGANIZER_nameFull] [circumstance_group]</li>
    <li>image->[ATTENDER_nameFull] гойдається в такт музиці [circumstance_group]</li>
    <li>image->[ATTENDER_nameFull] поринає у звуки музики [circumstance_group]</li>
    <li>circumstance_phrase->плескаючи в долоні</li>
    <li>desc_sentence->[Quantity_adjphrase] [PersonJob_pl_gen] танцюють під музику.</li>
    <li>desc_sentence->[Quantity_adjphrase] [Animal_pl_gen] уважно слухають.</li>
  </AttendedConcert.rulePack.rulesStrings>
  <!-- EN: held concert -->
