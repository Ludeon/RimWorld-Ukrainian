<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- Shuttle landing zones -->
  <!-- EN: Shuttle could not land on pad: {0} -->
  <ShuttleBlocked>Шатл не може приземлитися на майданчик: {0}</ShuttleBlocked>
  <!-- EN: The shuttle arrived, but since there were no colonists inside, the contents were lost. -->
  <MessageShuttleArrivedContentsLost>Шатл прибув, але оскільки всередині не було колоністів, вантаж втрачено.</MessageShuttleArrivedContentsLost>
  <!-- EN: Cannot land in undiscovered area. -->
  <ShuttleCannotLand_Fogged>Неможливо приземлитись на нерозвіданих територіях.</ShuttleCannotLand_Fogged>
  <!-- EN: Area must be walkable. -->
  <ShuttleCannotLand_Unwalkable>Місцевість має бути прохідною.</ShuttleCannotLand_Unwalkable>
  <!-- EN: Terrain does not support {0}. -->
  <ShuttleCannotLand_Unaffordable>Місцевість не витримає {0}.</ShuttleCannotLand_Unaffordable>
  <!-- EN: Select {BESTOWER_definite} and click 'Begin bestowing ceremony' to commence the ceremony. -->
  <MessageBestowerWaiting>Виберіть емісара ({BESTOWER_definite}) й натисніть «Розпочати церемонію нагородження», щоб почати церемонію.</MessageBestowerWaiting>
  <!-- EN: Cannot reach bestower! -->
  <MessageBestowerUnreachable>Неможливо дістатися до емісара!</MessageBestowerUnreachable>
  <!-- EN: {0} is busy. -->
  <MessageBestowingTargetIsBusy>{0} має інші справи.</MessageBestowingTargetIsBusy>
  <!-- EN: The bestower is annoyed with the interference and has decided to leave. -->
  <MessageBestowingSpotUnreachable>Емісар роздратований втручанням і вирішив піти.</MessageBestowingSpotUnreachable>
  <!-- EN: The bestower is leaving due to life-threatening danger. -->
  <MessageBestowingDanger>Емісар іде через смертельну небезпеку.</MessageBestowingDanger>
  <!-- EN: The bestower is leaving due to life-threatening temperature. -->
  <MessageBestowingDangerTemperature>Емісар іде через небезпечну для життя температуру.</MessageBestowingDangerTemperature>
  <!-- EN: The bestower is leaving due to dangerous gases in the area. -->
  <MessageBestowingDangerGas>Емісар іде через небезпечні гази поблизу.</MessageBestowingDangerGas>
  <!-- EN: The bestowing ceremony has been interrupted. -->
  <MessageBestowingInterrupted>Церемонію нагородження перервано.</MessageBestowingInterrupted>
  <!-- EN: {PAWN_definite}'s bestowing ceremony has begun. -->
  <MessageBestowingCeremonyStarted>Почалася церемонія нагородження: {PAWN_definite}.</MessageBestowingCeremonyStarted>
  <!-- EN: You defeated the {FACTION_pawnsPlural}! Get back on the shuttle to launch it. -->
  <MessageMissionGetBackToShuttle>Ворога переможено ({FACTION_pawnsPlural})! Поверніться на шатл, щоб злетіти.</MessageMissionGetBackToShuttle>
  <!-- EN: {FACTION_name} has dropped resources nearby. -->
  <MessagePermitTransportDrop>Фракція {FACTION_name} скинула ресурси неподалік.</MessagePermitTransportDrop>
  <!-- EN: {FACTION_name} has sent resources to {PAWN_nameDef}'s caravan. -->
  <MessagePermitTransportDropCaravan>Фракція {FACTION_name} надіслала ресурси до каравану, у якому подорожує {PAWN_nameDef}.</MessagePermitTransportDropCaravan>
  <!-- EN: No orbiting mechanoids found. -->
  <MessageNoFactionForVerbMechCluster>Механоїдів на орбіті не знайдено.</MessageNoFactionForVerbMechCluster>
</LanguageData>
