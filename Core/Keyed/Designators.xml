  <!-- EN: Interaction spot overlaps with the interaction spot of {1_labelShort}. -->
  <InteractionSpotOverlaps>Місце взаємодії накладається на місце взаємодії {lookup: {1_labelShort}; Case; 1}.</InteractionSpotOverlaps>
