<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- EN: Cancel -->
  <DesignatorCancel>Скасувати</DesignatorCancel>
  <!-- EN: Cancel designated building, mining, hauling, harvesting, and all other designations. -->
  <DesignatorCancelDesc>Скасувати позначки будівництва, видобутку, перенесення, збирання врожаю та всі інші.</DesignatorCancelDesc>
  <!-- EN: Cut plants -->
  <DesignatorCutPlants>Зрізати рослини</DesignatorCutPlants>
  <!-- EN: Marks plants to be cut and destroyed. The plant will be completely removed, and any food or resource yield will be harvested. -->
  <DesignatorCutPlantsDesc>Позначити рослини, які треба зрізати й знищити. Рослину буде повністю прибрано, а весь урожай чи інші ресурси – зібрано.</DesignatorCutPlantsDesc>
  <!-- EN: Deconstruct -->
  <DesignatorDeconstruct>Розібрати</DesignatorDeconstruct>
  <!-- EN: Deconstruct this and reclaim part of its resources. -->
  <DesignatorDeconstructDesc>Розібрати та повернути частину ресурсів.</DesignatorDeconstructDesc>
  <!-- EN: Deconstruct conduit -->
  <DesignatorDeconstructConduit>Розібрати кабель</DesignatorDeconstructConduit>
  <!-- EN: Deconstruct power conduits and reclaim part of their resources. -->
  <DesignatorDeconstructConduitDesc>Розібрати електрокабелі й повернути частину ресурсів.</DesignatorDeconstructConduitDesc>
  <!-- EN: Uninstall -->
  <DesignatorUninstall>Демонтувати</DesignatorUninstall>
  <!-- EN: Uninstall this so it can be moved, sold, or installed somewhere else. -->
  <DesignatorUninstallDesc>Демонтувати, щоб перемістити, продати чи встановити деінде.</DesignatorUninstallDesc>
  <!-- EN: Extract tree -->
  <DesignatorExtractTree>Викопати дерево</DesignatorExtractTree>
  <!-- EN: Extract this tree while keeping it alive so it can be replanted somewhere else. -->
  <DesignatorExtractTreeDesc>Викопати дерево живим, щоб пересадити його деінде.</DesignatorExtractTreeDesc>
  <!-- EN: Harvest -->
  <DesignatorHarvest>Зібрати</DesignatorHarvest>
  <!-- EN: Marks plants to be harvested for their food or other products. -->
  <DesignatorHarvestDesc>Позначити рослини, з яких треба зібрати їжу чи інші продукти.</DesignatorHarvestDesc>
  <!-- EN: Chop wood -->
  <DesignatorHarvestWood>Зрубати дерева</DesignatorHarvestWood>
  <!-- EN: Marks trees to be chopped down for wood. -->
  <DesignatorHarvestWoodDesc>Позначити дерева, які треба зрубати на деревину.</DesignatorHarvestWoodDesc>
  <!-- EN: Haul things -->
  <DesignatorHaulThings>Перенести речі</DesignatorHaulThings>
  <!-- EN: Mark rock chunks and other items to be hauled to dumping areas. Not needed for things like food or corpses, which are always haulable. -->
  <DesignatorHaulThingsDesc>Позначити уламки породи та інші предмети, які треба перенести на звалище. Для їжі, трупів тощо це не потрібно – їх переносять завжди.</DesignatorHaulThingsDesc>
  <!-- EN: Can only designate haulable but non-always-hauled things (like rock chunks). -->
  <MustHaulHaulables>Можна позначити лише те, що колоністи не переносять самостійно (наприклад, уламки гірських порід чи металобрухт).</MustHaulHaulables>
  <!-- EN: Hunt -->
  <DesignatorHunt>Полювати</DesignatorHunt>
  <!-- EN: Mark animals to be hunted by your hunters.\n\nOnly hunters with suitable ranged weapons will hunt. -->
  <DesignatorHuntDesc>Позначити тварин, на яких полюватимуть ваші мисливці.\n\nПолюватимуть лише мисливці з придатною далекобійною зброєю.</DesignatorHuntDesc>
  <!-- EN: Mine -->
  <DesignatorMine>Видобути</DesignatorMine>
  <!-- EN: Designate areas of rock to be mined out. -->
  <DesignatorMineDesc>Позначити ділянки породи для видобування.</DesignatorMineDesc>
  <!-- EN: Mine vein -->
  <DesignatorMineVein>Видобути жилу</DesignatorMineVein>
  <!-- EN: Designate an area of rock to be mined. Colonists will continue to mine until all connected rock of the same type has been mined. -->
  <DesignatorMineVeinDesc>Позначити ділянку породи для видобування. Колоністи видобуватимуть, доки не виберуть усю суміжну породу того самого типу.</DesignatorMineVeinDesc>
  <!-- EN: Smooth surface -->
  <DesignatorSmoothSurface>Вирівняти камінь</DesignatorSmoothSurface>
  <!-- EN: Designate rough stone terrain and walls to be smoothed. -->
  <DesignatorSmoothSurfaceDesc>Позначити необроблену кам'яну поверхню та стіни для вирівнювання.</DesignatorSmoothSurfaceDesc>
  <!-- EN: Smooth walls -->
  <DesignatorSmoothWalls>Вирівняти стіни</DesignatorSmoothWalls>
  <!-- EN: Designate rough stone walls to be smoothed. -->
  <DesignatorSmoothWallsDesc>Позначити необроблені кам'яні стіни для вирівнювання.</DesignatorSmoothWallsDesc>
  <!-- EN: Smooth terrain -->
  <DesignatorSmoothFloors>Вирівняти поверхню</DesignatorSmoothFloors>
  <!-- EN: Designate rough stone terrain to be smoothed. -->
  <DesignatorSmoothFloorsDesc>Позначити необроблену кам'яну поверхню для вирівнювання.</DesignatorSmoothFloorsDesc>
  <!-- EN: Plan -->
  <DesignatorPlan>Планування</DesignatorPlan>
  <!-- EN: Place planning designations. These don't do anything except help you plan future expansions.\n\nRight-click to hide or unhide all planning zones. -->
  <DesignatorPlanDesc>Розмістити позначки планування. Вони нічого не роблять, лише допомагають планувати розбудову.\n\nКлацніть правою кнопкою миші, щоб сховати чи показати всі зони планування.</DesignatorPlanDesc>
  <!-- EN: Remove plans -->
  <DesignatorPlanRemove>Прибрати план</DesignatorPlanRemove>
  <!-- EN: Remove planning designations. -->
  <DesignatorPlanRemoveDesc>Прибрати позначки планування.</DesignatorPlanRemoveDesc>
  <!-- EN: Forbid -->
  <DesignatorForbid>Заборонити</DesignatorForbid>
  <!-- EN: Mark items as forbidden. Colonists will not be able to interact with the designated items. -->
  <DesignatorForbidDesc>Позначити предмети як заборонені. Колоністи не взаємодіятимуть із ними.</DesignatorForbidDesc>
  <!-- EN: Allow -->
  <DesignatorUnforbid>Дозволити</DesignatorUnforbid>
  <!-- EN: Mark items as not forbidden. Colonists will be able to interact with the designated items. -->
  <DesignatorUnforbidDesc>Позначити предмети як дозволені. Колоністи зможуть із ними взаємодіяти.</DesignatorUnforbidDesc>
  <!-- EN: Expand home area -->
  <DesignatorAreaHomeExpand>Розширити домашню область</DesignatorAreaHomeExpand>
  <!-- EN: Colonists will repair buildings, clean floors, and extinguish fires only in the home area. -->
  <DesignatorAreaHomeExpandDesc>Колоністи ремонтують споруди, прибирають підлогу й гасять пожежі тільки в домашній області.</DesignatorAreaHomeExpandDesc>
  <!-- EN: Clear home area -->
  <DesignatorAreaHomeClear>Зменшити домашню область</DesignatorAreaHomeClear>
  <!-- EN: Removes a home area. Colonists will no longer clean, repair, or extinguish fires here. -->
  <DesignatorAreaHomeClearDesc>Прибирає домашню область. Колоністи більше не прибиратимуть, не ремонтуватимуть і не гаситимуть тут пожеж.</DesignatorAreaHomeClearDesc>
  <!-- EN: Build roof area -->
  <DesignatorAreaBuildRoofExpand>Область будівництва даху</DesignatorAreaBuildRoofExpand>
  <!-- EN: Colonists will build roofs in this area. -->
  <DesignatorAreaBuildRoofExpandDesc>Колоністи будуватимуть дах у цій області.</DesignatorAreaBuildRoofExpandDesc>
  <!-- EN: Remove roof area -->
  <DesignatorAreaNoRoofExpand>Область розбирання даху</DesignatorAreaNoRoofExpand>
  <!-- EN: Colonists will remove roofs in this area (except overhead mountain, which cannot be removed). -->
  <DesignatorAreaNoRoofExpandDesc>Колоністи розбиратимуть дах у цій області (крім товщі гірської породи – її прибрати неможливо).</DesignatorAreaNoRoofExpandDesc>
  <!-- EN: Ignore roof area -->
  <DesignatorAreaIgnoreRoofExpand>Ігнорувати дах</DesignatorAreaIgnoreRoofExpand>
  <!-- EN: Colonists will ignore roofs in this area. -->
  <DesignatorAreaIgnoreRoofExpandDesc>Колоністи не будуватимуть автоматично дах у цій області.</DesignatorAreaIgnoreRoofExpandDesc>
  <!-- EN: Snow removal area -->
  <DesignatorAreaSnowClearExpand>Область прибирання снігу</DesignatorAreaSnowClearExpand>
  <!-- EN: Create an area which colonists will try to keep clear of snow. -->
  <DesignatorAreaSnowClearExpandDesc>Створити область, яку колоністи намагатимуться очищати від снігу.</DesignatorAreaSnowClearExpandDesc>
  <!-- EN: Clear snow removal area -->
  <DesignatorAreaSnowClearClear>Зменшити область прибирання снігу</DesignatorAreaSnowClearClear>
  <!-- EN: Removes a snow removal area. Colonists will no longer try to keep this area clear of snow. -->
  <DesignatorAreaSnowClearClearDesc>Зменшує область прибирання снігу. Колоністи більше не чиститимуть тут сніг.</DesignatorAreaSnowClearClearDesc>
  <!-- EN: Expand allowed area -->
  <DesignatorExpandAreaAllowed>Розширити дозволену область</DesignatorExpandAreaAllowed>
  <!-- EN: Expand an allowed area.\n\nAllowed areas are defined areas you can assign to colonists. Colonists will not accept work or fulfill their needs outside their allowed area. -->
  <DesignatorExpandAreaAllowedDesc>Розширити дозволену область.\n\nДозволені області – це задані вами ділянки, які можна призначати колоністам. Поза своєю дозволеною областю колоністи не працюють і не задовольняють потреб.</DesignatorExpandAreaAllowedDesc>
  <!-- EN: Clear allowed area -->
  <DesignatorClearAreaAllowed>Зменшити дозволену область</DesignatorClearAreaAllowed>
  <!-- EN: Clear cells from an allowed area.\n\nAllowed area are defined areas you can assign to colonists. Colonists will not accept work or fulfill their needs outside their allowed area. -->
  <DesignatorClearAreaAllowedDesc>Прибрати клітинки з дозволеної області.\n\nДозволені області – це задані вами ділянки, які можна призначати колоністам. Поза своєю дозволеною областю колоністи не працюють і не задовольняють потреб.</DesignatorClearAreaAllowedDesc>
  <!-- EN: Manage areas... -->
  <ManageAreas>Керування областями...</ManageAreas>
  <!-- EN: Manage auto-slaughter... -->
  <ManageAutoSlaughter>Керування автозабоєм...</ManageAutoSlaughter>
  <!-- EN: Create a zone where your colonists will try to grow a certain kind of plant. -->
  <DesignatorGrowingZoneDesc>Створити зону, де колоністи вирощуватимуть певну рослину.</DesignatorGrowingZoneDesc>
  <!-- EN: Create a stockpile where your colonists will store resources.\nThis tool can also expand any existing stockpile. -->
  <DesignatorZoneCreateStorageResourcesDesc>Створити склад, де колоністи зберігатимуть ресурси.\nЦим інструментом також можна розширити наявний склад.</DesignatorZoneCreateStorageResourcesDesc>
  <!-- EN: Create a stockpile where your colonists will store junk.\nThis tool can also expand any existing stockpile. -->
  <DesignatorZoneCreateStorageDumpingDesc>Створити звалище, куди колоністи зноситимуть мотлох.\nЦим інструментом також можна розширити наявний склад.</DesignatorZoneCreateStorageDumpingDesc>
  <!-- EN: Shrink zones -->
  <DesignatorZoneDelete>Зменшити зони</DesignatorZoneDelete>
  <!-- EN: Shrink zone -->
  <DesignatorZoneDeleteSingular>Зменшити зону</DesignatorZoneDeleteSingular>
  <!-- EN: Remove zones, like stockpile zones or growing zones. -->
  <DesignatorZoneDeleteDesc>Прибрати зони, як-от склади чи зони вирощування.</DesignatorZoneDeleteDesc>
  <!-- EN: Expand zone -->
  <DesignatorZoneExpand>Розширити зону</DesignatorZoneExpand>
  <!-- EN: Claim -->
  <DesignatorClaim>Привласнити</DesignatorClaim>
  <!-- EN: Claim neutral structures for the colony, including ancient ruins and abandoned siege bases. Claimed structures can be repaired and maintained by your colonists. -->
  <DesignatorClaimDesc>Привласнити колонії нейтральні споруди, зокрема старовинні руїни й покинуті облогові табори. Привласнені споруди колоністи можуть ремонтувати й обслуговувати.</DesignatorClaimDesc>
  <!-- EN: Remove floor -->
  <DesignatorRemoveFloor>Зняти підлогу</DesignatorRemoveFloor>
  <!-- EN: Remove floors to reveal the terrain underneath. -->
  <DesignatorRemoveFloorDesc>Зняти підлогу, щоб відкрити поверхню під нею.</DesignatorRemoveFloorDesc>
  <!-- EN: Remove bridge -->
  <DesignatorRemoveBridge>Розібрати міст</DesignatorRemoveBridge>
  <!-- EN: Deconstruct bridges to reclaim partial resources. -->
  <DesignatorRemoveBridgeDesc>Розібрати мости, щоб повернути частину ресурсів.</DesignatorRemoveBridgeDesc>
  <!-- EN: Strip -->
  <DesignatorStrip>Роздягти</DesignatorStrip>
  <!-- EN: Strip apparel from corpses and the wounded. -->
  <DesignatorStripDesc>Зняти одяг з трупів і поранених.</DesignatorStripDesc>
  <!-- EN: Open -->
  <DesignatorOpen>Відкрити</DesignatorOpen>
  <!-- EN: Open containers. -->
  <DesignatorOpenDesc>Відкрити контейнери.</DesignatorOpenDesc>
  <!-- EN: Eject fuel -->
  <DesignatorEjectFuel>Злити паливо</DesignatorEjectFuel>
  <!-- EN: Eject all contained fuel onto the ground. -->
  <DesignatorEjectFuelDesc>Вивантажити все паливо на землю.</DesignatorEjectFuelDesc>
  <!-- EN: Slaughter -->
  <DesignatorSlaughter>Забити</DesignatorSlaughter>
  <!-- EN: Slaughter a tame animal. -->
  <DesignatorSlaughterDesc>Забити приручену тварину.</DesignatorSlaughterDesc>
  <!-- EN: Tame -->
  <DesignatorTame>Приручити</DesignatorTame>
  <!-- EN: Tame a wild animal. -->
  <DesignatorTameDesc>Приручити дику тварину.</DesignatorTameDesc>
  <!-- EN: Scaria infected animals can't be tamed. -->
  <CantTameScaria>Заражених скаріозом тварин неможливо приручити.</CantTameScaria>
  <!-- EN: Release to wild -->
  <DesignatorReleaseAnimalToWild>Відпустити на волю</DesignatorReleaseAnimalToWild>
  <!-- EN: Release an animal back into the wild. -->
  <DesignatorReleaseAnimalToWildDesc>Відпустити тварину назад у дику природу.</DesignatorReleaseAnimalToWildDesc>
  <!-- EN: Study -->
  <DesignatorStudy>Вивчити</DesignatorStudy>
  <!-- EN: Study this object to learn more about it. -->
  <DesignatorStudyDesc>Вивчити цей об'єкт, щоб дізнатися про нього більше.</DesignatorStudyDesc>
  <!-- EN: Paint building... -->
  <DesignatorPaintBuilding>Пофарбувати споруду...</DesignatorPaintBuilding>
  <!-- EN: Designate walls and buildings to be painted using dye from tinctoria plants, which you can grow. Only certain buildings can be painted. -->
  <DesignatorPaintBuildingDesc>Позначити стіни й споруди, які треба пофарбувати барвником із тинкторії – її можна виростити. Фарбувати можна лише деякі споруди.</DesignatorPaintBuildingDesc>
  <!-- EN: Paint floor... -->
  <DesignatorPaintFloor>Пофарбувати підлогу...</DesignatorPaintFloor>
  <!-- EN: Designate floors to be painted using dye from tinctoria plants, which you can grow. Only certain floors can be painted. -->
  <DesignatorPaintFloorDesc>Позначити підлогу, яку треба пофарбувати барвником із тинкторії – її можна виростити. Фарбувати можна лише деякі види підлоги.</DesignatorPaintFloorDesc>
  <!-- EN: Remove paint -->
  <DesignatorRemovePaint>Прибрати фарбу</DesignatorRemovePaint>
  <!-- EN: Remove paint from walls, buildings, and floors. -->
  <DesignatorRemovePaintDesc>Прибрати фарбу зі стін, споруд і підлоги.</DesignatorRemovePaintDesc>
  <!-- EN: Remove floor paint -->
  <DesignatorRemoveFloorPaint>Прибрати фарбу з підлоги</DesignatorRemoveFloorPaint>
  <!-- EN: Remove paint from floors. -->
  <DesignatorRemoveFloorPaintDesc>Прибрати фарбу з підлоги.</DesignatorRemoveFloorPaintDesc>
  <!-- EN: Paint -->
  <Paint>Пофарбувати</Paint>
  <!-- EN: Color -->
  <Color>Колір</Color>
  <!-- EN: Color picker -->
  <DesignatorEyedropper>Піпетка</DesignatorEyedropper>
  <!-- EN: Grab existing color -->
  <GrabExistingColor>Взяти наявний колір</GrabExistingColor>
  <!-- EN: Grab a color from an existing building. -->
  <DesignatorEyeDropperDesc_Paint>Взяти колір наявної споруди.</DesignatorEyeDropperDesc_Paint>
  <!-- EN: Grab a color from an existing carpet. -->
  <DesignatorEyeDropperDesc_Carpet>Взяти колір наявного килима.</DesignatorEyeDropperDesc_Carpet>
  <!-- EN: Select a painted building. -->
  <SelectAPaintedBuilding>Виберіть пофарбовану споруду.</SelectAPaintedBuilding>
  <!-- EN: Select colored carpet. -->
  <SelectColoredFloor>Виберіть кольоровий килим.</SelectColoredFloor>
  <!-- EN: Grab -->
  <Grab>Взяти</Grab>
  <!-- EN: Grabbed color -->
  <GrabbedColor>Взятий колір</GrabbedColor>
  <!-- EN: Expand plan -->
  <DesignatorExpandPlan>Розширити план</DesignatorExpandPlan>
  <!-- EN: New plan -->
  <NewPlan>Новий план</NewPlan>
  <!-- EN: Shrink plan -->
  <DesignatorPlanShrinkSingular>Зменшити план</DesignatorPlanShrinkSingular>
  <!-- EN: Remove plans. -->
  <DesignatorPlanShrinkDesc>Прибрати плани.</DesignatorPlanShrinkDesc>
  <!-- Failure messages -->
  <!-- EN: Unchosen material -->
  <UnchosenStuff>Матеріал не вибрано</UnchosenStuff>
  <!-- EN: Too close to map edge. -->
  <TooCloseToMapEdge>Надто близько до краю мапи.</TooCloseToMapEdge>
  <!-- EN: Out of bounds. -->
  <OutOfBounds>За межами мапи.</OutOfBounds>
  <!-- EN: Cannot place in undiscovered areas. -->
  <CannotPlaceInUndiscovered>Не можна розміщувати в нерозвіданих областях.</CannotPlaceInUndiscovered>
