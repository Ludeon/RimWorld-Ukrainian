  <InteractionSpotBlocked>{1_labelShort} блокує місце взаємодії.</InteractionSpotBlocked>
  <!-- EN: Interaction spot is out of bounds. -->
  <InteractionSpotOutOfBounds>Місце взаємодії за межами мапи.</InteractionSpotOutOfBounds>
