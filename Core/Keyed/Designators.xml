  <!-- EN: {0_label} (when made of {2_label}) requires terrain that supports: {1_label} -->
  <TerrainCannotSupport_TerrainAffordanceFromStuff>{0_label} (з матеріалу «{2_label}») потребує поверхні з такою властивістю: {1_label}</TerrainCannotSupport_TerrainAffordanceFromStuff>
