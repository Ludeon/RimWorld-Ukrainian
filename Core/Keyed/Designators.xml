  <SpaceAlreadyOccupied>Місце вже зайнято.</SpaceAlreadyOccupied>
  <!-- EN: Space being smoothed. -->
  <SpaceBeingSmoothed>Тут триває вирівнювання.</SpaceBeingSmoothed>
  <!-- EN: Must target a removable floor. -->
  <TerrainMustBeRemovable>Потрібно вибрати знімну підлогу.</TerrainMustBeRemovable>
  <!-- EN: The waterwheel must be on moving water. -->
  <MustBeOnMovingWater>Водяне колесо має стояти на проточній воді.</MustBeOnMovingWater>
