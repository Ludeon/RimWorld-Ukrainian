<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- EN: became lover -->
  <BecameLover.label>початок романтичних стосунків</BecameLover.label>
  <!-- EN:
    <li>tale_noun->[PURSUER_nameDef] and [ACCEPTER_nameDef] becoming lovers</li>
    <li>image->[PURSUER_nameFull] whispering sweet nothings into [ACCEPTER_nameFull]'s ear [circumstance_group]</li>
    <li>image->[PURSUER_nameFull] leading [ACCEPTER_nameFull] by the hand into bed [circumstance_group]</li>
    <li>image->[PURSUER_nameFull] gambolling in bed with [ACCEPTER_nameFull] [circumstance_group]</li>
    <li>image->[PURSUER_nameFull] deeply kissing [ACCEPTER_nameFull] [circumstance_group]</li>
    <li>circumstance_phrase->in an unrealistically large bed</li>
    <li>circumstance_phrase->between the sheets</li>
    <li>circumstance_phrase->with few clothes in sight</li>
    <li>circumstance_phrase->while both are drenched in sweat</li>
    <li>desc_sentence->[PURSUER_nameDef] is snuggling up against [ACCEPTER_nameDef].</li>
    <li>desc_sentence->[PURSUER_nameDef] is locking eyes with [ACCEPTER_nameDef].</li>
    <li>desc_sentence->[PURSUER_nameDef] is blowing air at [ACCEPTER_nameDef].</li>
    <li>desc_sentence->[PURSUER_nameDef] is stylistically bonded with [ACCEPTER_nameDef].</li>
    <li>desc_sentence->[PURSUER_nameDef] is a near-mirror image of [ACCEPTER_nameDef].</li>
    <li>desc_sentence->[PURSUER_nameDef] is touching [ACCEPTER_nameDef] aggressively.</li>
  -->
  <BecameLover.rulePack.rulesStrings>
    <li>tale_noun->[PURSUER_nameDef] і [ACCEPTER_nameDef] стають коханцями</li>
    <li>image->[PURSUER_nameFull] шепоче ніжності на вухо {ACCEPTER_gender ? коханому : коханій} на ім’я [ACCEPTER_nameFull], [circumstance_group]</li>
    <li>image->[PURSUER_nameFull] веде за руку до ліжка {ACCEPTER_gender ? коханого : кохану} на ім’я [ACCEPTER_nameFull], [circumstance_group]</li>
    <li>image->[PURSUER_nameFull] і [ACCEPTER_nameFull] пустують у ліжку, [circumstance_group]</li>
    <li>image->[PURSUER_nameFull] і [ACCEPTER_nameFull] пристрасно цілуються, [circumstance_group]</li>
    <li>circumstance_phrase->у неправдоподібно величезному ліжку</li>
    <li>circumstance_phrase->під ковдрою</li>
    <li>circumstance_phrase->майже без одягу</li>
    <li>circumstance_phrase->обоє мокрі від поту</li>
    <li>desc_sentence->[PURSUER_nameDef] пригортається до {ACCEPTER_gender ? коханого : коханої}.</li>
    <li>desc_sentence->[PURSUER_nameDef] і [ACCEPTER_nameDef] не зводять одне з одного очей.</li>
    <li>desc_sentence->[PURSUER_nameDef] дмухає на {ACCEPTER_gender ? коханого : кохану}.</li>
    <li>desc_sentence->[PURSUER_nameDef] і [ACCEPTER_nameDef] зображені як стилістичне ціле.</li>
    <li>desc_sentence->[PURSUER_nameDef] — майже дзеркальне відображення {ACCEPTER_gender ? коханого : коханої}.</li>
    <li>desc_sentence->[PURSUER_nameDef] напористо пестить {ACCEPTER_gender ? коханого : кохану}.</li>
  </BecameLover.rulePack.rulesStrings>
  <!-- EN: bond developed -->
  <BondedWithAnimal.label>прив’язаність до тварини</BondedWithAnimal.label>
  <!-- EN:
    <li>tale_noun->[HUMAN_nameDef]'s bonding with [ANIMAL_nameDef]</li>
    <li>image->[HUMAN_nameFull] bonding with [ANIMAL_nameFull] [circumstance_group]</li>
    <li>image->[HUMAN_nameFull] forming a deep bond with [ANIMAL_nameFull] [circumstance_group]</li>
    <li>image->[HUMAN_nameFull] realizing [HUMAN_possessive] truly loves [ANIMAL_nameFull] [circumstance_group]</li>
    <li>circumstance_phrase->while other animals look on</li>
    <li>circumstance_phrase->while looking into [ANIMAL_nameDef]'s eyes</li>
    <li>circumstance_phrase->with a sense of satisfaction</li>
    <li>desc_sentence->[ANIMAL_nameDef] is snuggling up against [HUMAN_nameDef].</li>
    <li>desc_sentence->[ANIMAL_nameDef] looks sleepy and drunk with love.</li>
    <li>desc_sentence->[ANIMAL_nameDef] stands tall and looks noble.</li>
    <li>desc_sentence->[ANIMAL_nameDef] is responding positively.</li>
  -->
  <BondedWithAnimal.rulePack.rulesStrings>
    <li>tale_noun->[HUMAN_nameDef] і [ANIMAL_nameDef] стають нерозлучними</li>
    <li>image->[HUMAN_nameFull] і [ANIMAL_nameFull] стають друзями, [circumstance_group]</li>
    <li>image->[HUMAN_nameFull] і [ANIMAL_nameFull] відчувають глибокий зв’язок, [circumstance_group]</li>
    <li>image->[HUMAN_nameFull] усвідомлює, що [ANIMAL_nameFull] — {HUMAN_gender ? його : її} найкращий друг, [circumstance_group]</li>
    <li>circumstance_phrase->поки інші тварини дивляться</li>
    <li>circumstance_phrase->поки [ANIMAL_nameDef] дивиться людині в очі</li>
    <li>circumstance_phrase->з почуттям задоволення</li>
    <li>desc_sentence->[ANIMAL_nameDef] тулиться до людини.</li>
    <li>desc_sentence->[ANIMAL_nameDef] сонно жмуриться від любові.</li>
    <li>desc_sentence->[ANIMAL_nameDef] стоїть, гордо випроставшись, і має шляхетний вигляд.</li>
    <li>desc_sentence->[ANIMAL_nameDef] радісно відгукується.</li>
  </BondedWithAnimal.rulePack.rulesStrings>
  <!-- EN: breakup -->
  <Breakup.label>розставання</Breakup.label>
  <!-- EN:
    <li>tale_noun->the breakup of [DUMPER_nameDef] and [REJECTED_nameDef]</li>
    <li>image->[DUMPER_nameFull] sitting [REJECTED_nameFull] down for an unpleasant talk [circumstance_group]</li>
    <li>image->[DUMPER_nameFull] standing at a distance from [REJECTED_nameFull] [circumstance_group]</li>
    <li>image->[DUMPER_nameFull] pushing [REJECTED_nameFull] out of bed [circumstance_group]</li>
    <li>image->[DUMPER_nameFull] rejecting a hug from [REJECTED_nameFull] [circumstance_group]</li>
    <li>circumstance_phrase->in a moment of great sadness</li>
    <li>circumstance_phrase->as others look away awkwardly</li>
    <li>circumstance_phrase->as others look on</li>
    <li>desc_sentence->[REJECTED_nameDef] is sobbing uncontrollably.</li>
    <li>desc_sentence->[REJECTED_nameDef] is sneering and crying at the same time.</li>
    <li>desc_sentence->[REJECTED_nameDef] is stony-faced with shock.</li>
    <li>desc_sentence->[DUMPER_nameDef] is stylistically separated from [REJECTED_nameDef].</li>
    <li>desc_sentence->[REJECTED_nameDef] has collapsed on the floor in a quivering heap.</li>
    <li>desc_sentence->[REJECTED_nameDef] is gesticulating angrily at [DUMPER_nameDef].</li>
  -->
  <Breakup.rulePack.rulesStrings>
    <li>tale_noun->[DUMPER_nameDef] і [REJECTED_nameDef] розходяться</li>
    <li>image->[DUMPER_nameFull] садовить {REJECTED_gender ? партнера : партнерку} на ім’я [REJECTED_nameFull] для неприємної розмови, [circumstance_group]</li>
    <li>image->[DUMPER_nameFull] тримається на відстані від {REJECTED_gender ? партнера : партнерки} на ім’я [REJECTED_nameFull], [circumstance_group]</li>
    <li>image->[DUMPER_nameFull] виштовхує з ліжка {REJECTED_gender ? партнера : партнерку} на ім’я [REJECTED_nameFull], [circumstance_group]</li>
    <li>image->[DUMPER_nameFull] не дає себе обійняти {REJECTED_gender ? партнерові : партнерці} на ім’я [REJECTED_nameFull], [circumstance_group]</li>
    <li>circumstance_phrase->у хвилину глибокого смутку</li>
    <li>circumstance_phrase->поки інші ніяково відводять очі</li>
    <li>circumstance_phrase->поки інші спостерігають</li>
    <li>desc_sentence->[REJECTED_nameDef] нестримно ридає.</li>
    <li>desc_sentence->[REJECTED_nameDef] водночас глузливо кривиться й плаче.</li>
    <li>desc_sentence->[REJECTED_nameDef] має кам’яне від шоку обличчя.</li>
    <li>desc_sentence->[DUMPER_nameDef] і [REJECTED_nameDef] зображені стилістично відокремленими одне від одного.</li>
    <li>desc_sentence->[REJECTED_nameDef] безсило осідає на підлогу й тремтить.</li>
    <li>desc_sentence->[REJECTED_nameDef] сердито жестикулює в бік {DUMPER_gender ? колишнього : колишньої}.</li>
  </Breakup.rulePack.rulesStrings>
  <!-- EN: marriage -->
  <Marriage.label>шлюб</Marriage.label>
  <!-- EN:
    <li>tale_noun->the marriage of [SPOUSE1_nameDef] and [SPOUSE2_nameDef]</li>
    <li>image->[SPOUSE1_nameFull] marrying [SPOUSE2_nameFull] [circumstance_group]</li>
    <li>image->[SPOUSE1_nameFull] saying [SPOUSE1_possessive] marriage vows to [SPOUSE2_nameFull] [circumstance_group]</li>
    <li>image->[SPOUSE1_nameFull] walking down the aisle with [SPOUSE2_nameFull] [circumstance_group]</li>
    <li>image->[SPOUSE1_nameFull] holding hands with [SPOUSE2_nameFull] during a marriage ceremony [circumstance_group]</li>
    <li>circumstance_phrase->in a dignified ceremony</li>
    <li>circumstance_phrase->while both laugh gaily</li>
    <li>circumstance_phrase->while others look on solemnly</li>
    <li>desc_sentence->[SPOUSE1_nameDef] is snuggling up against [SPOUSE2_nameDef].</li>
    <li>desc_sentence->[SPOUSE1_nameDef] is locking eyes with [SPOUSE2_nameDef].</li>
    <li>desc_sentence->[SPOUSE1_nameDef] is blowing air at [SPOUSE2_nameDef].</li>
    <li>desc_sentence->[SPOUSE1_nameDef] is stylistically bonded with [SPOUSE2_nameDef].</li>
    <li>desc_sentence->[SPOUSE1_nameDef] is a near-mirror image of [SPOUSE2_nameDef].</li>
    <li>desc_sentence->[SPOUSE1_nameDef] is touching [SPOUSE2_nameDef] aggressively.</li>
  -->
  <Marriage.rulePack.rulesStrings>
    <li>tale_noun->[SPOUSE1_nameDef] і [SPOUSE2_nameDef] беруть шлюб</li>
    <li>image->[SPOUSE1_nameFull] і [SPOUSE2_nameFull] одружуються, [circumstance_group]</li>
    <li>image->[SPOUSE1_nameFull] промовляє шлюбну обітницю {SPOUSE2_gender ? нареченому : нареченій} на ім’я [SPOUSE2_nameFull], [circumstance_group]</li>
    <li>image->[SPOUSE1_nameFull] і [SPOUSE2_nameFull] йдуть до вівтаря, [circumstance_group]</li>
    <li>image->[SPOUSE1_nameFull] і [SPOUSE2_nameFull] тримаються за руки під час весільної церемонії, [circumstance_group]</li>
    <li>circumstance_phrase->на урочистій церемонії</li>
    <li>circumstance_phrase->весело сміючись</li>
    <li>circumstance_phrase->поки інші урочисто спостерігають</li>
    <li>desc_sentence->[SPOUSE1_nameDef] пригортається до {SPOUSE2_gender ? чоловіка : дружини}.</li>
    <li>desc_sentence->[SPOUSE1_nameDef] і [SPOUSE2_nameDef] не зводять одне з одного очей.</li>
    <li>desc_sentence->[SPOUSE1_nameDef] дмухає на {SPOUSE2_gender ? чоловіка : дружину}.</li>
    <li>desc_sentence->[SPOUSE1_nameDef] і [SPOUSE2_nameDef] зображені як стилістичне ціле.</li>
    <li>desc_sentence->[SPOUSE1_nameDef] — майже дзеркальне відображення {SPOUSE2_gender ? чоловіка : дружини}.</li>
    <li>desc_sentence->[SPOUSE1_nameDef] напористо пестить {SPOUSE2_gender ? чоловіка : дружину}.</li>
  </Marriage.rulePack.rulesStrings>
</LanguageData>
