<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- EN: collapse dodged -->
  <CollapseDodged.label>обвалення стелі</CollapseDodged.label>
  <!-- EN:
    <li>tale_noun->[PAWN_nameDef] dodging a cave-in</li>
    <li>tale_noun->[PAWN_nameDef] nearly crushed by falling objects</li>
    <li>image->[PAWN_nameFull] leaping away from a collapse of debris [circumstance_group]</li>
    <li>image->[PAWN_nameFull] narrowly avoiding a cave-in [circumstance_group]</li>
    <li>image->[PAWN_nameFull] avoiding a falling ceiling [circumstance_group]</li>
    <li>image->[PAWN_nameFull] avoiding certain death by a falling rock [circumstance_group]</li>
    <li>circumstance_phrase->that vanishes behind a curtain of debris and dust</li>
    <li>circumstance_phrase->that pulverizes everything beneath it</li>
    <li>circumstance_phrase->which impacts with incredible force</li>
    <li>desc_sentence->[PAWN_pronoun] is sweating with exertion.</li>
    <li>desc_sentence->[PAWN_pronoun] appears to be terrified.</li>
    <li>desc_sentence->[PAWN_pronoun] is scratched and bleeding.</li>
    <li>desc_sentence->[PAWN_pronoun] has lost [PAWN_possessive] balance.</li>
  -->
  <CollapseDodged.rulePack.rulesStrings>
    <li>tale_noun->[PAWN_nameDef] уникає обвалу</li>
    <li>tale_noun->[PAWN_nameDef] ледь не гине під уламками</li>
    <li>image->[PAWN_nameFull] відскакує від обвалу, [circumstance_group]</li>
    <li>image->[PAWN_nameFull] дивом уникає завалу, [circumstance_group]</li>
    <li>image->[PAWN_nameFull] ухиляється від уламків стелі, [circumstance_group]</li>
    <li>image->[PAWN_nameFull] уникає певної смерті від каменя, [circumstance_group]</li>
    <li>circumstance_phrase->що зникає за завісою уламків і пилу</li>
    <li>circumstance_phrase->що розтирає на порох усе під собою</li>
    <li>circumstance_phrase->що обрушується з неймовірною силою</li>
    <li>desc_sentence->{PAWN_gender ? Він : Вона} обливається потом від напруги.</li>
    <li>desc_sentence->{PAWN_gender ? Він, схоже, нажаханий : Вона, схоже, нажахана}.</li>
    <li>desc_sentence->{PAWN_gender ? Він увесь подряпаний : Вона вся подряпана} і в крові.</li>
    <li>desc_sentence->{PAWN_gender ? Він утратив : Вона втратила} рівновагу.</li>
  </CollapseDodged.rulePack.rulesStrings>
  <!-- EN: launched ship -->
  <LaunchedShip.label>запуск корабля</LaunchedShip.label>
  <!-- EN:
    <li>tale_noun->[PAWN_nameDef] escaping the planet</li>
    <li>tale_noun->[PAWN_nameDef] taking off in a spaceship</li>
    <li>image->[PAWN_nameFull] being launched towards the stars [circumstance_group]</li>
    <li>image->[PAWN_nameFull] racing towards the heavens [circumstance_group]</li>
    <li>image->[PAWN_nameFull] accelerating to escape velocity [circumstance_group]</li>
    <li>image->[PAWN_nameFull] piloting a rocket [circumstance_group]</li>
    <li>circumstance_phrase->in front of a [TerrainFeature]</li>
    <li>circumstance_phrase->with incredible force</li>
    <li>circumstance_phrase->in a plume of dust and rocks</li>
    <li>circumstance_phrase->with rockets firing dramatically</li>
    <li>circumstance_phrase->in a precision takeoff</li>
    <li>desc_sentence->[PAWN_pronoun] is concentrating intently on the controls.</li>
    <li>desc_sentence->[PAWN_pronoun] has [PAWN_possessive] eyes closed and looks confident.</li>
    <li>desc_sentence->[PAWN_pronoun] is sleeping, [PAWN_possessive] eyes closed peacefully.</li>
    <li>desc_sentence->[PAWN_pronoun] is smiling with grim joy.</li>
    <li>desc_sentence->[PAWN_pronoun] seems to be fully in control of the situation.</li>
    <li>desc_sentence->There is a flame trail licking off the back of the ship.</li>
    <li>desc_sentence->A nearby [Animal] is looking up, startled.</li>
    <li>desc_sentence->A [Animal] is fleeing the launch in fear.</li>
    <li>desc_sentence->There is a [TerrainFeature] in the background.</li>
    <li>desc_sentence->A [PersonJob] watches silently from afar.</li>
  -->
  <LaunchedShip.rulePack.rulesStrings>
    <li>tale_noun->[PAWN_nameDef] залишає планету</li>
    <li>tale_noun->[PAWN_nameDef] злітає на космічному кораблі</li>
    <li>image->[PAWN_nameFull] злітає до зірок [circumstance_group]</li>
    <li>image->[PAWN_nameFull] мчить у небеса [circumstance_group]</li>
    <li>image->[PAWN_nameFull] розганяється до другої космічної швидкості [circumstance_group]</li>
    <li>image->[PAWN_nameFull] пілотує ракету [circumstance_group]</li>
    <li>circumstance_phrase->на тлі [TerrainFeature_gen]</li>
    <li>circumstance_phrase->з неймовірною силою</li>
    <li>circumstance_phrase->у хмарі пилу й каміння</li>
    <li>circumstance_phrase->під ефектний рев ракетних двигунів</li>
    <li>circumstance_phrase->у бездоганному зльоті</li>
    <li>desc_sentence->{PAWN_gender ? Він : Вона} зосереджено стежить за приладами.</li>
    <li>desc_sentence->{PAWN_gender ? Він заплющив : Вона заплющила} очі й має впевнений вигляд.</li>
    <li>desc_sentence->{PAWN_gender ? Він : Вона} спить, спокійно заплющивши очі.</li>
    <li>desc_sentence->{PAWN_gender ? Він : Вона} всміхається з похмурою радістю.</li>
    <li>desc_sentence->{PAWN_gender ? Він : Вона}, схоже, повністю контролює ситуацію.</li>
    <li>desc_sentence->З корми корабля виривається вогняний шлейф.</li>
    <li>desc_sentence->Неподалік [Animal] злякано дивиться вгору.</li>
    <li>desc_sentence->[Animal] зі страху тікає від місця запуску.</li>
    <li>desc_sentence->На задньому плані видніється [TerrainFeature].</li>
    <li>desc_sentence->[PersonJob] мовчки спостерігає здалеку.</li>
  </LaunchedShip.rulePack.rulesStrings>
  <!-- EN: social fight -->
  <SocialFight.label>конфлікт</SocialFight.label>
  <!-- EN:
    <li>tale_noun->[INITIATOR_nameDef] [fight_name_present] [RESPONDER_nameDef]</li>
    <li>image->[INITIATOR_nameFull] insulting [RESPONDER_nameFull] [circumstance_group]</li>
    <li>image->[INITIATOR_nameFull] taunting [RESPONDER_nameFull] [circumstance_group]</li>
    <li>image->[INITIATOR_nameFull] threatening [RESPONDER_nameFull] [circumstance_group]</li>
    <li>image->[INITIATOR_nameFull] intimidating [RESPONDER_nameFull] [circumstance_group]</li>
    <li>image->[INITIATOR_nameFull] attacking [RESPONDER_nameFull] [circumstance_group]</li>
    <li>image->[INITIATOR_nameFull] assaulting [RESPONDER_nameFull] [circumstance_group]</li>
    <li>image->[INITIATOR_nameFull] punching [RESPONDER_nameFull] [circumstance_group]</li>
    <li>image->[INITIATOR_nameFull] kicking [RESPONDER_nameFull] [circumstance_group]</li>
    <li>image->[INITIATOR_nameFull] cowering from [RESPONDER_nameFull] [circumstance_group]</li>
    <li>fight_name_present->assaulting</li>
    <li>fight_name_present->attacking</li>
    <li>fight_name_present->fighting</li>
    <li>circumstance_phrase->while [RESPONDER_nameDef] insults [INITIATOR_objective]</li>
    <li>circumstance_phrase->while [RESPONDER_nameDef] taunts [INITIATOR_objective]</li>
    <li>circumstance_phrase->while [RESPONDER_nameDef] threatens [INITIATOR_objective]</li>
