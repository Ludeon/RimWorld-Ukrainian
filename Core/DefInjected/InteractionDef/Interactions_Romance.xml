  <!-- EN: breakup -->
  <Breakup.label>розставання</Breakup.label>
  <!-- EN:
    <li>r_logentry->[INITIATOR_nameDef] asked [RECIPIENT_nameDef] for a break.</li>
    <li>r_logentry->[INITIATOR_nameDef] asked [RECIPIENT_nameDef] for some space.</li>
    <li>r_logentry->[INITIATOR_nameDef] told [RECIPIENT_nameDef] that it's not working out.</li>
    <li>r_logentry->[INITIATOR_nameDef] told [RECIPIENT_nameDef] that it would be best to see other people.</li>
  -->
  <Breakup.logRulesInitiator.rulesStrings>
    <li>r_logentry->[RECIPIENT_nameDef]: [INITIATOR_nameDef] {INITIATOR_gender ? запропонував : запропонувала} {RECIPIENT_gender ? йому : їй} зробити перерву.</li>
    <li>r_logentry->[RECIPIENT_nameDef]: [INITIATOR_nameDef] {INITIATOR_gender ? попросив : попросила} в {RECIPIENT_gender ? нього : неї} трохи особистого простору.</li>
    <li>r_logentry->[RECIPIENT_nameDef]: [INITIATOR_nameDef] {INITIATOR_gender ? сказав : сказала} {RECIPIENT_gender ? йому : їй}, що в них нічого не виходить.</li>
    <li>r_logentry->[RECIPIENT_nameDef]: [INITIATOR_nameDef] {INITIATOR_gender ? сказав : сказала} {RECIPIENT_gender ? йому : їй}, що їм краще зустрічатися з іншими.</li>
  </Breakup.logRulesInitiator.rulesStrings>
