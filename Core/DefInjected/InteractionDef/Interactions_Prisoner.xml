  <!-- EN: recruit attempt -->
  <RecruitAttempt.label>спроба вербування</RecruitAttempt.label>
  <!-- EN:
    <li>r_logentry->[INITIATOR_nameDef] asked [RECIPIENT_nameDef] to join.</li>
    <li>r_logentry->[INITIATOR_nameDef] promised [goodthing] to [RECIPIENT_nameDef], and asked [RECIPIENT_objective] to join.</li>
    <li>goodthing(p=15)->[ConceptPositive]</li>
    <li>goodthing->free, fresh [Vegetable]s</li>
  -->
  <RecruitAttempt.logRulesInitiator.rulesStrings>
    <li>r_logentry->[RECIPIENT_nameDef]: [INITIATOR_nameDef] {INITIATOR_gender ? запропонував : запропонувала} {RECIPIENT_gender ? йому : їй} приєднатися.</li>
    <li>r_logentry->[RECIPIENT_nameDef]: [INITIATOR_nameDef] {INITIATOR_gender ? пообіцяв : пообіцяла} {RECIPIENT_gender ? йому : їй} [goodthing] і {INITIATOR_gender ? запропонував : запропонувала} приєднатися.</li>
    <li>goodthing(p=15)->[ConceptPositive_acc]</li>
    <li>goodthing->безплатні свіжі [Vegetable_pl]</li>
  </RecruitAttempt.logRulesInitiator.rulesStrings>
  <!-- EN: spark jailbreak -->
  <SparkJailbreak.label>спроба втечі</SparkJailbreak.label>
  <!-- EN:
    <li>r_logentry->[INITIATOR_nameDef] spoke about the joy of [freedom], and offered a means of escape.</li>
    <li>r_logentry->[INITIATOR_nameDef] talked about how beautiful the [TerrainFeature] is, and offered freedom.</li>
    <li>r_logentry->[INITIATOR_nameDef] demonstrated a means of escape to [RECIPIENT_nameDef], and promised [freedom].</li>
    <li>r_logentry->[INITIATOR_nameDef] told [RECIPIENT_nameDef] that security is lax, and encouraged escape.</li>
    <li>freedom->freedom</li>
    <li>freedom->opportunity</li>
    <li>freedom->home</li>
    <li>freedom->self-determination</li>
  -->
  <SparkJailbreak.logRulesInitiator.rulesStrings>
    <li>r_logentry->[INITIATOR_nameDef] {INITIATOR_gender ? говорив : говорила} про [freedom] і {INITIATOR_gender ? запропонував : запропонувала} спосіб утекти.</li>
    <li>r_logentry->[INITIATOR_nameDef] {INITIATOR_gender ? розповідав : розповідала} про красу [TerrainFeature_gen] і {INITIATOR_gender ? пообіцяв : пообіцяла} свободу.</li>
    <li>r_logentry->[RECIPIENT_nameDef]: [INITIATOR_nameDef] {INITIATOR_gender ? показав : показала} {RECIPIENT_gender ? йому : їй} спосіб утекти й {INITIATOR_gender ? пообіцяв : пообіцяла} [freedom].</li>
    <li>r_logentry->[RECIPIENT_nameDef]: [INITIATOR_nameDef] {INITIATOR_gender ? сказав : сказала} {RECIPIENT_gender ? йому : їй}, що охорона недбала, і {INITIATOR_gender ? підбурив : підбурила} до втечі.</li>
    <li>freedom->свободу</li>
    <li>freedom->нові можливості</li>
    <li>freedom->повернення додому</li>
    <li>freedom->самовизначення</li>
  </SparkJailbreak.logRulesInitiator.rulesStrings>
