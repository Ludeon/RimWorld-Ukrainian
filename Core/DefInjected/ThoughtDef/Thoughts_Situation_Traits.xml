  <!-- EN: happily nude -->
  <HappyNude.stages.happily_nude.label>{PAWN_gender ? голий та щасливий : гола та щаслива}</HappyNude.stages.happily_nude.label>
  <!-- EN: I'm nude and loving it! I feel so free and unconstrained and in touch with my surroundings! -->
  <HappyNude.stages.happily_nude.description>Я {PAWN_gender ? голий : гола}, і мені це страшенно подобається! Почуваюся {PAWN_gender ? вільним, розкутим і єдиним : вільною, розкутою і єдиною} з усім довкола!</HappyNude.stages.happily_nude.description>
