<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- EN:
    <li>questDescription->[faction_leader_nameFull], [faction_leaderTitle] of [faction_name], has sent us a message. [faction_leader_pronoun] wants to talk with us in a nearby location.\n\nIt could be a great opportunity to improve relations with their faction and receive gifts, but beware - a poor negotiator can cause more harm than good and may even anger them.[extraLeaderPart][favorRewardDetails]</li>
    <li>favorRewardDetails(faction_leader_royalInCurrentFaction==True,priority=1)->\n\nSuccessful peace talks can earn your negotiator a small amount of personal [faction_royalFavorLabel] with [faction_name].</li>
    <li>favorRewardDetails-></li>
    <li>extraLeaderPart(priority=1)->\n\n[leaderRoleEffect].[leaderPawnInfo]</li>
    <li>extraLeaderPart-></li>
    <li>leaderRoleEffect->Other factions will respect you more if you send your leader to handle the negotiations</li>
    <li>leaderPawnInfo(playerFaction_hasLeader==True,priority=1)-> [playerFaction_leaderTitle] [playerFaction_leader_nameFull] will get a bonus to the chance of a successful outcome.</li>
    <li>leaderPawnInfo-></li>
  -->
  <OpportunitySite_PeaceTalks.questDescriptionRules.rulesStrings>
    <li>questDescription->[faction_leader_nameFull], [faction_leaderTitle] фракції [faction_name], {faction_leader_gender ? надіслав : надіслала} нам повідомлення. {faction_leader_gender ? Він : Вона} хоче зустрітися з нами для розмови неподалік.\n\nЦе чудова нагода поліпшити стосунки з їхньою фракцією й отримати подарунки, але стережіться: невправний перемовник може більше нашкодити, ніж допомогти, і навіть розлютити їх.[extraLeaderPart][favorRewardDetails]</li>
    <li>favorRewardDetails(faction_leader_royalInCurrentFaction==True,priority=1)->\n\nУспішні мирні переговори можуть принести вашому перемовникові трохи особистої нагороди «[faction_royalFavorLabel]» від фракції [faction_name].</li>
    <li>favorRewardDetails-></li>
    <li>extraLeaderPart(priority=1)->\n\n[leaderRoleEffect].[leaderPawnInfo]</li>
    <li>extraLeaderPart-></li>
    <li>leaderRoleEffect->Інші фракції більше поважатимуть вас, якщо вести переговори ви відправите свого лідера</li>
    <li>leaderPawnInfo(playerFaction_hasLeader==True,priority=1)-> [playerFaction_leaderTitle] [playerFaction_leader_nameFull] матиме більше шансів на успіх.</li>
    <li>leaderPawnInfo-></li>
  </OpportunitySite_PeaceTalks.questDescriptionRules.rulesStrings>
  <!-- EN:
    <li>questName->[faction_leader_nameDef]'s [peaceTalks]</li>
    <li>questName->[peaceTalks] with [faction_leader_nameDef]</li>
    <li>questName->The [peaceTalks]</li>
    <li>questName->[peaceTalks]</li>
    <li>peaceTalks->Peace Talks</li>
    <li>peaceTalks->Diplomacy</li>
    <li>peaceTalks->Meeting</li>
  -->
  <OpportunitySite_PeaceTalks.questNameRules.rulesStrings>
    <li>questName->[faction_leader_nameDef]: [peaceTalks]</li>
    <li>questName->[peaceTalks]: [faction_leader_nameDef]</li>
    <li>questName->[peaceTalks]</li>
    <li>questName->[peaceTalks]</li>
    <li>peaceTalks->Мирні переговори</li>
    <li>peaceTalks->Дипломатія</li>
    <li>peaceTalks->Зустріч</li>
  </OpportunitySite_PeaceTalks.questNameRules.rulesStrings>
  <!-- EN: Quest expired: [resolvedQuestName] -->
  <OpportunitySite_PeaceTalks.LetterLabelQuestExpired.slateRef>Завдання більше не актуальне: [resolvedQuestName]</OpportunitySite_PeaceTalks.LetterLabelQuestExpired.slateRef>
  <!-- EN: The offer of peace talks with [faction_name] has expired. You have failed the quest [resolvedQuestName]. -->
  <OpportunitySite_PeaceTalks.LetterTextQuestExpired.slateRef>Пропозиція мирних переговорів з фракцією [faction_name] втратила чинність. Завдання «[resolvedQuestName]» провалено.</OpportunitySite_PeaceTalks.LetterTextQuestExpired.slateRef>
</LanguageData>
