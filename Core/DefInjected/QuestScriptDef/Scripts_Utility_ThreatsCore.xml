<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- EN: <rulesStrings><li>root(priority=1,sitePart==ClimateAdjuster)->there's (*Threat)a climate adjuster machine(/Threat) there shifting the regional temperature by [temperatureOffset]</li><li>root(priority=1,sitePart==PsychicDroner)->there's (*Threat)a psychic droner machine(/Threat) there tuned to the [affectedGender] gender</li><li>root(priority=1,sitePart==PsychicSuppressor)->there's (*Threat)a psychic suppressor machine(/Threat) there tuned to the [affectedGender] gender</li><li>root(priority=1,sitePart==WeatherController)->there's (*Threat)a weather controller machine(/Threat) there forcing weather in the whole region to [weather_label]</li><li>root(priority=1,sitePart==SmokeSpewer)->there's (*Threat)a smoke spewer machine(/Threat) there belching smoke over the whole region</li><li>root(priority=1,sitePart==SunBlocker)->there's (*Threat)a sun blocker machine(/Threat) there shadowing the whole region</li><li>root(priority=1,sitePart==EMIDynamo)->there's (*Threat)an EMI dynamo machine(/Threat) there which can disable electrical devices across the region</li><li>root(priority=1,sitePart==ToxicSpewer)->there's (*Threat)a toxic spewer machine(/Threat) there blanketing the whole region in poison</li><li>root(priority=1,sitePart==RaidSource)->there's a military staging area guarded by (*Threat)[enemiesCount] [enemiesLabel](/Threat) that will launch raids on you every [mtbDays]</li><li>root(priority=1,sitePart==Outpost)->there's an enemy outpost at the site guarded by (*Threat)[enemiesCount] [enemiesLabel](/Threat)</li><li>root(priority=1,sitePart==BanditCamp)->there's a bandit camp at the site guarded by (*Threat)[enemiesCount] [enemiesLabel](/Threat)</li><li>root(priority=1,sitePart==Manhunters,count==1)->(*Threat)a manhunting [kindLabel](/Threat) is wandering nearby</li><li>root(priority=1,sitePart==Manhunters,count>1)->(*Threat)[count] manhunting [kindLabel](/Threat) are wandering nearby</li><li>root(priority=1,sitePart==SleepingMechanoids,count==1)->(*Threat)a mechanoid(/Threat) is sleeping nearby</li><li>root(priority=1,sitePart==SleepingMechanoids,count>1)->(*Threat)[count] mechanoids(/Threat) are sleeping nearby</li><li>root(priority=1,sitePart==Turrets)->(*Threat)[threatsInfo](/Threat) defend the site</li><li>root(priority=1,sitePart==AmbushEdge)->(*Threat)an enemy force(/Threat) is waiting to ambush anyone who comes near</li><li>root(priority=1,sitePart==AmbushHidden)->(*Threat)an enemy force(/Threat) is waiting to ambush anyone who comes near</li><li>root(priority=1,sitePart==MechCluster)->there's (*Threat)a cluster of hostile mechanoid structures(/Threat)</li><li>root(priority=1,sitePart==PossibleUnknownThreatMarker)->there may be an (*Threat)unknown threat(/Threat)</li><li>root->there's a [label]</li></rulesStrings> -->
  <Util_GenerateSite.root.singleSitePartRules.slateRef>
    <li>root(priority=1,sitePart==ClimateAdjuster)->там працює (*Threat)регулятор клімату(/Threat), що змінює температуру в регіоні на [temperatureOffset]</li>
    <li>root(priority=1,sitePart==PsychicDroner)->там працює (*Threat)генератор психічного гулу(/Threat), налаштований на {replace: [affectedGender]; "чоловік"-"чоловіків"; "жінка"-"жінок"}</li>
    <li>root(priority=1,sitePart==PsychicSuppressor)->там працює (*Threat)генератор психічного пригнічення(/Threat), налаштований на {replace: [affectedGender]; "чоловік"-"чоловіків"; "жінка"-"жінок"}</li>
    <li>root(priority=1,sitePart==WeatherController)->там працює (*Threat)погодний регулятор(/Threat), що встановлює в усьому регіоні погоду «[weather_label]»</li>
    <li>root(priority=1,sitePart==SmokeSpewer)->там працює (*Threat)димогенератор(/Threat), що вкриває димом увесь регіон</li>
    <li>root(priority=1,sitePart==SunBlocker)->там працює (*Threat)блокувач сонця(/Threat), що затьмарює весь регіон</li>
    <li>root(priority=1,sitePart==EMIDynamo)->там працює (*Threat)ЕМІ-генератор(/Threat), здатний вивести з ладу електроприлади по всьому регіону</li>
    <li>root(priority=1,sitePart==ToxicSpewer)->там працює (*Threat)розпилювач токсинів(/Threat), що отруює весь регіон</li>
    <li>root(priority=1,sitePart==RaidSource)->там розташований військовий плацдарм, який охороняють (*Threat)[enemiesLabel] ([enemiesCount])(/Threat); звідти на вас нападатимуть кожні [mtbDays]</li>
    <li>root(priority=1,sitePart==Outpost)->там розташований ворожий форпост, який охороняють (*Threat)[enemiesLabel] ([enemiesCount])(/Threat)</li>
    <li>root(priority=1,sitePart==BanditCamp)->там розташований бандитський табір, який охороняють (*Threat)[enemiesLabel] ([enemiesCount])(/Threat)</li>
    <li>root(priority=1,sitePart==Manhunters,count==1)->неподалік блукає (*Threat)агресивна тварина ([kindLabel])(/Threat)</li>
    <li>root(priority=1,sitePart==Manhunters,count>1)->неподалік блукають (*Threat)агресивні тварини ([kindLabel]: [count])(/Threat)</li>
    <li>root(priority=1,sitePart==SleepingMechanoids,count==1)->неподалік спить (*Threat)механоїд(/Threat)</li>
    <li>root(priority=1,sitePart==SleepingMechanoids,count>1)->неподалік сплять (*Threat)механоїди ([count])(/Threat)</li>
    <li>root(priority=1,sitePart==Turrets)->місцевість охороняють (*Threat)[threatsInfo](/Threat)</li>
    <li>root(priority=1,sitePart==AmbushEdge)->(*Threat)ворожий загін(/Threat) чатує в засідці на кожного, хто наблизиться</li>
    <li>root(priority=1,sitePart==AmbushHidden)->(*Threat)ворожий загін(/Threat) чатує в засідці на кожного, хто наблизиться</li>
    <li>root(priority=1,sitePart==MechCluster)->там є (*Threat)кластер ворожих механоїдних споруд(/Threat)</li>
    <li>root(priority=1,sitePart==PossibleUnknownThreatMarker)->там може бути (*Threat)невідома загроза(/Threat)</li>
    <li>root->там є [label]</li>
  </Util_GenerateSite.root.singleSitePartRules.slateRef>
  <!-- EN:
    <li>threatDescription->a mech cluster will land at [map_definite] containing:\n\n[allThreats]</li>
  -->
  <Util_MechCluster.questDescriptionRules.rulesStrings>
    <li>threatDescription->у поселенні [map_definite] приземлиться кластер механоїдів. До його складу входять:\n\n[allThreats]</li>
  </Util_MechCluster.questDescriptionRules.rulesStrings>
  <!-- EN:
    <li>threatDescription->[enemyFaction_pawnsPlural] from [enemyFaction_name] will attack you. Their group is composed of:\n\n[raidPawnKinds]\n\n[raidArrivalModeInfo]</li>
  -->
  <Util_Raid.questDescriptionRules.rulesStrings>
    <li>threatDescription->[enemyFaction_pawnsPlural] з фракції [enemyFaction_name] нападуть на вас. До їхнього загону входять:\n\n[raidPawnKinds]\n\n[raidArrivalModeInfo]</li>
  </Util_Raid.questDescriptionRules.rulesStrings>
  <!-- EN:
    <li>pawnKindsParagraph(raidCount==1)->The group of [enemyFaction_pawnsPlural] is composed of: \n\n[raid0/raidPawnKinds]\n\n[raid0/raidArrivalModeInfo]</li>
    <li>pawnKindsParagraph(raidCount==2)->The first group of [enemyFaction_pawnsPlural] is composed of: \n\n[raid0/raidPawnKinds]\n\nThe second similar-sized group will follow soon after.</li>
    <li>pawnKindsParagraph(raidCount==3)->The first group of [enemyFaction_pawnsPlural] is composed of: \n\n[raid0/raidPawnKinds]\n\nTwo similar-sized groups will follow soon after.</li>
    <li>pawnKindsParagraph(raidCount>=4)->The first group of [enemyFaction_pawnsPlural] is composed of: \n\n[raid0/raidPawnKinds]\n\n[raidCountMinusOne] similar-sized groups will follow soon after.</li>
    <li>numGroupsOf(raidCount==1)-></li>
    <li>numGroupsOf(raidCount==2)->two groups of</li>
    <li>numGroupsOf(raidCount==3)->three groups of</li>
    <li>numGroupsOf(raidCount>=4)->[raidCount] groups of</li>
  -->
  <Util_RaidDelayRepeatable.questDescriptionRules.rulesStrings>
    <li>pawnKindsParagraph(raidCount==1)->До загону {lookup: [enemyFaction_pawnsPlural]; Case; 1} входять: \n\n[raid0/raidPawnKinds]\n\n[raid0/raidArrivalModeInfo]</li>
    <li>pawnKindsParagraph(raidCount==2)->До першого загону {lookup: [enemyFaction_pawnsPlural]; Case; 1} входять: \n\n[raid0/raidPawnKinds]\n\nНезабаром за ним прийде другий загін схожого розміру.</li>
    <li>pawnKindsParagraph(raidCount==3)->До першого загону {lookup: [enemyFaction_pawnsPlural]; Case; 1} входять: \n\n[raid0/raidPawnKinds]\n\nНезабаром за ним прийдуть ще два загони схожого розміру.</li>
    <li>pawnKindsParagraph(raidCount==4,priority=1)->До першого загону {lookup: [enemyFaction_pawnsPlural]; Case; 1} входять: \n\n[raid0/raidPawnKinds]\n\nНезабаром за ним прийдуть ще три загони схожого розміру.</li>
    <li>pawnKindsParagraph(raidCount==5,priority=1)->До першого загону {lookup: [enemyFaction_pawnsPlural]; Case; 1} входять: \n\n[raid0/raidPawnKinds]\n\nНезабаром за ним прийдуть ще чотири загони схожого розміру.</li>
    <li>pawnKindsParagraph(raidCount>=4)->До першого загону {lookup: [enemyFaction_pawnsPlural]; Case; 1} входять: \n\n[raid0/raidPawnKinds]\n\nНезабаром за ним прийдуть ще [raidCountMinusOne] загонів схожого розміру.</li>
    <li>numGroupsOf(raidCount==1)-></li>
    <li>numGroupsOf(raidCount==2)->дві групи</li>
    <li>numGroupsOf(raidCount==3)->три групи</li>
    <li>numGroupsOf(raidCount==4,priority=1)->чотири групи</li>
    <li>numGroupsOf(raidCount>=4)->[raidCount] груп</li>
  </Util_RaidDelayRepeatable.questDescriptionRules.rulesStrings>
</LanguageData>
