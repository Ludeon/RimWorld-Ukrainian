  <!-- EN: broadhead -->
  <BroadheadArrows.traitAdjectives.1>широколезий</BroadheadArrows.traitAdjectives.1>
  <!-- EN: charge capacitor -->
  <ChargeCapacitor.label>конденсатор заряду</ChargeCapacitor.label>
  <!-- EN: This weapon amplifies pulse-charge technology with a massive capacitor, increasing damage and armor penetration. -->
  <ChargeCapacitor.description>Ця зброя підсилює імпульсно-зарядну технологію потужним конденсатором, що збільшує шкоду й пробиття броні.</ChargeCapacitor.description>
  <!-- EN: overcharged -->
  <ChargeCapacitor.traitAdjectives.0>надзаряджений</ChargeCapacitor.traitAdjectives.0>
  <!-- EN: cumbersome -->
