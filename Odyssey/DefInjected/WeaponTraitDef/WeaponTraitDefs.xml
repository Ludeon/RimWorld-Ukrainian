  <!-- EN: broadhead arrows -->
  <BroadheadArrows.label>широкі стріли</BroadheadArrows.label>
  <!-- EN: This bow shoots arrows tipped with sharp blades, increasing its damage. -->
  <BroadheadArrows.description>Цей лук стріляє стрілами з гострими лезовими наконечниками, що збільшує його шкоду.</BroadheadArrows.description>
