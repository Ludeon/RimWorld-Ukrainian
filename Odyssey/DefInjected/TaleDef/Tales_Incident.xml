<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- EN: orbital debris -->
  <OrbitalDebris.label>орбітальні уламки</OrbitalDebris.label>
  <!-- EN:
    <li>tale_noun->a micrometeorite storm sweeping over [PAWN_nameDef]'s [Community]</li>
    <li>tale_noun->micrometeorite fragments peppering the area around [PAWN_nameDef]'s [Community]</li>
    <li>image->a cascade of micrometeorites glimmering with [Color] sparks [airborne_circumstance]</li>
    <li>image->a scattering of brightly-glowing micrometeorites [airborne_circumstance]</li>
    <li>image->a shower of [Color] sparks as micrometeorites blaze [airborne_circumstance]</li>
    <li>airborne_circumstance->racing across the sky</li>
    <li>airborne_circumstance->tumbling down in a flurry of light</li>
    <li>airborne_circumstance->dissipating into shimmering dust as they fall</li>
    <li>image->a cluster of smoldering impact marks, [ground_circumstance]</li>
    <li>image->a [Color] scorched fragment, [ground_circumstance]</li>
    <li>image->a [Color] scatter of tiny stones, [ground_circumstance]</li>
    <li>ground_circumstance->surrounded by a haze of fine dust</li>
    <li>ground_circumstance->glowing faintly from residual heat</li>
    <li>ground_circumstance->embedded in a blanket of cracked ground</li>
    <li>ground_circumstance->scattered across the landscape</li>
    <li>ground_circumstance->dotted amidst a field of minor craters</li>
    <li>desc_sentence->[PAWN_nameDef] watches the shower in awe.</li>
    <li>desc_sentence->[PAWN_nameDef] gazes up in wonder.</li>
    <li>desc_sentence->[PAWN_nameDef] is startled by the relentless barrage.</li>
    <li>desc_sentence->[Quantity_adjphrase] figures emerge from a nearby [TerrainFeature] to take shelter.</li>
    <li>desc_sentence->[Quantity_adjphrase] figures scramble to secure their belongings.</li>
    <li>desc_sentence->[Quantity_adjphrase] [Animal]s scurry about, seeking cover.</li>
    <li>desc_sentence->Space is charged with an eerie power.</li>
  -->
  <OrbitalDebris.rulePack.rulesStrings>
    <li>tale_noun->шторм мікрометеоритів проноситься над [Community_ins], де живе [PAWN_nameDef]</li>
    <li>tale_noun->уламки мікрометеоритів засипають околиці [Community_gen], де живе [PAWN_nameDef]</li>
    <li>image->каскад мікрометеоритів, що виблискують [Color_pl_ins] іскрами й [airborne_circumstance]</li>
    <li>image->розсип яскраво сяйних мікрометеоритів, що [airborne_circumstance]</li>
    <li>image->злива [Color_pl_gen] іскор від мікрометеоритів, що палахкотять і [airborne_circumstance]</li>
    <li>airborne_circumstance->мчать небом</li>
    <li>airborne_circumstance->падають у вихорі світла</li>
    <li>airborne_circumstance->розсипаються мерехтливим пилом, падаючи</li>
    <li>image->скупчення тліючих слідів від ударів, [ground_circumstance]</li>
    <li>image->[Color] обпалений уламок, [ground_circumstance]</li>
    <li>image->[Color] розсип дрібних камінців, [ground_circumstance]</li>
    <li>ground_circumstance->в імлі дрібного пилу</li>
    <li>ground_circumstance->у слабкому сяйві залишкового жару</li>
    <li>ground_circumstance->посеред потрісканої землі</li>
    <li>ground_circumstance->по всій місцевості</li>
    <li>ground_circumstance->серед поля дрібних кратерів</li>
    <li>desc_sentence->[PAWN_nameDef] з благоговінням дивиться на метеоритну зливу.</li>
    <li>desc_sentence->[PAWN_nameDef] зачудовано дивиться вгору.</li>
    <li>desc_sentence->[PAWN_nameDef] здригається від безупинного обстрілу.</li>
    <li>desc_sentence->[Quantity_adjphrase] постатей виходять з-за [TerrainFeature_gen] неподалік, шукаючи прихистку.</li>
    <li>desc_sentence->[Quantity_adjphrase] постатей поспіхом рятують свої пожитки.</li>
    <li>desc_sentence->[Quantity_adjphrase] [Animal_pl_gen] метушаться, шукаючи укриття.</li>
    <li>desc_sentence->Простір сповнений моторошної сили.</li>
  </OrbitalDebris.rulePack.rulesStrings>
</LanguageData>
