<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  <!-- Fishing -->
  <!-- EN: do X times -->
  <FishRepeatMode_RepeatCount>зробити X разів</FishRepeatMode_RepeatCount>
  <!-- EN: do until you have X -->
  <FishRepeatMode_TargetCount>повторювати до X на складі</FishRepeatMode_TargetCount>
  <!-- EN: do forever -->
  <FishRepeatMode_Forever>нескінченно</FishRepeatMode_Forever>
  <!-- EN: Fish population -->
  <FishPopulation>Популяція риби</FishPopulation>
  <!-- EN: How many fish are in this body of water. Larger bodies of water have more fish and will recover fish populations faster. -->
  <FishPopulationDesc>Скільки риби в цій водоймі. У більших водоймах риби більше, і її популяція відновлюється швидше.</FishPopulationDesc>
  <!-- EN: Minimum population -->
  <MinimumPopulation>Мінімальна популяція</MinimumPopulation>
  <!-- EN: Colonists won't fish if the fish population is under this limit. Fishing yields are lower if there are less than 300 fish. -->
  <MinimumPopulationDesc>Колоністи не рибалитимуть, якщо популяція риби нижча за цю межу. Якщо риби менше 300, улов менший.</MinimumPopulationDesc>
  <!-- EN: uncommon -->
  <Uncommon>рідкісна</Uncommon>
  <!-- EN: When toggled off, colonists will avoid catching this fish. -->
  <ToggleFishAvoid>Якщо вимкнути, колоністи намагатимуться не ловити цю рибу.</ToggleFishAvoid>
</LanguageData>
